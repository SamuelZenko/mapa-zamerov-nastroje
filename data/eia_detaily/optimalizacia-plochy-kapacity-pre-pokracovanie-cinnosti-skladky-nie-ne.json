", "date": "27.02. 2025"}]}, {"title": "Oznámenie o informácií o navrhovanej činnosti alebo jej zmene", "items": [{"type": "PDF", "label": "Informácia pre verejnosť FCC.pdf", "id": "389205", "url": "/eia/dokument/389205", "filesize": "329310", "date": "27.02. 2025"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia navrhovanej činnosti", "items": [{"type": "PDF", "label": "FCC -Zohor - RH.pdf", "id": "390727", "url": "/eia/dokument/390727", "filesize": "948575", "date": "15.04. 2025"}]}]}, {"step": "Správa o hodnotení", "number": 3, "items": [{"title": "Informácia    o správe o hodnotení", "items": [{"type": "PDF", "label": "FCC -Zohor - informcia o SoH.pdf", "id": "396286", "url": "/eia/dokument/396286", "filesize": "286430", "date": "08.10. 2025"}]}, {"type": "text", "label": "Spracovateľ správy o hodnotení", "value": ""}, {"title": "Text správy o hodnotení", "items": [{"type": "PDF", "label": "priloha Skladka_FCC_Zohor_HGposudok_II_Redigovane.pdf", "id": "396289", "url": "/eia/dokument/396289", "filesize": "7191308", "date": "08.10. 2025"}, {"type": "ZIP", "label": "prilohy_grafické.zip", "id": "396288", "url": "/eia/dokument/396288", "filesize": "7220484", "date": "08.10. 2025"}, {"type": "PDF", "label": "FCC_Zohor stavba5_SOH.pdf", "id": "396287", "url": "/eia/dokument/396287", "filesize": "4986713", "date": "08.10. 2025"}]}]}, {"step": "Záverečné stanovisko", "number": 4, "items": [{"title": "Záverečné stanovisko pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "FCC Zohor_záverečné stanovisko.pdf", "id": "400440", "url": "/eia/dokument/400440", "filesize": "1591310", "date": "12.02. 2026"}]}, {"title": "Právoplatné záverečné stanovisko", "items": [{"type": "PDF", "label": "Doložka právoplatnosti.pdf", "id": "400954", "url": "/eia/dokument/400954", "filesize": "65904", "date": "03.03. 2026"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place":