{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-blatne-zmeny-doplnky-c-1-2015", "@type": "EiaProject", "id": "126140", "seoId": "uzemny-plan-obce-blatne-zmeny-doplnky-c-1-2015", "name": "Územný plán obce Blatné - Zmeny a doplnky č. 1/2015", "zbierka": "24/2006 novela 314/2014 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Cieľom riešenia \" Zmiena doplnkov č. 1/2015\" je umiestnenie nových plôch určených na novú zástavbu, umiestnenie nových plôch určených na rekonštrukciu a revitalizáciu, umiestnenie zámerov líniových stavieb dopravnej a technickej vybavenosti, vymdezenie existujúcich funkčných plôch, zakreslenie skutkového stavu, komplexná úprava zásad a regulatívov v záväznej textovej časti, odstránenie nezrovnalosti v grafickom spracovaní platného ÚPN a úpravy grafického znázornenia, zosúladenie ÚPN obce s nadradenou dokuemntáciou ÚPN regiónu BSK.", "navrhovatel": {"name": "Obec Blatné, Obecný úrad, 900 82 Blatné, Šarfická 300/37", "ico": "00507822"}, "prislusnyOrgan": {"name": "Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Blatné (okres: Senec)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia pre verejnost - Blatné.pdf", "id": "242680", "url": "/eia/dokument/242680", "filesize": "203900", "date": "16.05. 2016"}]}, {"title": "Oznámenie", "items": [{"type": "JPG", "label": "Vykres 2 Blatne ZaD12015.jpg", "id": "242673", "url": "/eia/dokument/242673", "filesize": "15198026", "date": "16.05. 2016"}, {"type": "JPG", "label": "Vykres 1 Blatne ZaD12015.jpg", "id": "242