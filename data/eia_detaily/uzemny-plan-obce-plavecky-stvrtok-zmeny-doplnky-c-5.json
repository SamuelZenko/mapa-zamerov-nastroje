{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-plavecky-stvrtok-zmeny-doplnky-c-5", "@type": "EiaProject", "id": "168074", "seoId": "uzemny-plan-obce-plavecky-stvrtok-zmeny-doplnky-c-5", "name": "Územný plán obce Plavecký Štvrtok – Zmeny a doplnky č. 5", "zbierka": "24/2006 novela 372/2021 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Obec Plavecký Štvrtok je podľa § 18 ods. 4 zákona č. 50/1976 Zb. o ÚP a SP v znení neskorších predpisov (ďalej stavebný zákon) obstarávateľom ÚPD obce. V zmysle § 30 stavebného zákona má orgán územného plánovania sledovať, či sa nezmenili územno-technické, hospodárske a sociálne predpoklady v území, resp. najmenej raz za štyri roky preskúmať ÚPN, či nie sú potrebné jeho ZaD alebo či netreba obstarať nový ÚPN. Na základe požiadaviek obce a jej občanov na rozvoj obce a iné zmeny riešenia platného ÚPN, obec pristúpila k spracovaniu ZaD platnej ÚPD.", "navrhovatel": {"name": "Obec Plavecký Štvrtok, Obecný úrad Plavecký Štvrtok č. 172, 900 68 Plavecký Štvrtok", "ico": "00305049"}, "prislusnyOrgan": {"name": "Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Jakubov, Zohor, Plavecký Štvrtok, Láb, Malacky, Kostolište, Lozorno (okres: Malacky)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo obce Plavecký Štvrtok", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia k Územnému plánu obce Plavecký Štvrtok ZaD.č.5.pdf", "id": "365791", "url": "/eia/dokument/365791", "filesize": "206742", "date": "28.06. 2023"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Oznámenie o strategickom dokumente.pdf", "id": "365792", "url": "/eia/dokument/365792", "filesize": "660810", "date": "28.06. 2023"}]}, {"title": "Rozhodnutie zo zisťovacieho konania", "items": [{"type": "PDF", "label": "Rozhodnutie.pdf", "id": "366996", "url": "/eia/dokument/366996", "filesize": "391139", "date": "21.07. 2023"}]}, {"title": "Text strategického dokumentu", "items": [{"type": "PDF", "label": "9C Komplexný urbanistický návrh – regulačná schéma, M 17500.pdf", "id": "365801", "url": "/eia/dokument/365801", "filesize": "722718", "date": "28.06. 2023"}, {"type": "PDF", "label": "7. Použitie poľnohospodárskej pôdy na nepoľnohospodárske účely, M 1 7500.pdf", "id": "365764", "url": "/eia/dokument/365764", "filesize": "1998806", "date": "28.06. 2023"}, {"type": "PDF", "label": "1 Širšie vzťahy, M 1 15000.pdf", "id": "365793", "url": "/eia/dokument/365793", "filesize": "2458366", "date": "28.06. 2023"}, {"type": "PDF", "label": "2 Komplexný urbanistický návrh, M 1 7500.pdf", "id": "365794", "url": "/eia/dokument/365794", "filesize": "2650500", "date": "28.06. 2023"}, {"type": "PDF", "label": "3. Návrh dopravy, M 1 7500.pdf", "id": "365795", "url": "/eia/dokument/365795", "filesize": "2484946", "date": "28.06. 2023"}, {"type": "PDF", "label": "4. Návrh vodného hospodárstva, M 1 7500.pdf", "id": "365797", "url": "/eia/dokument/365797", "filesize": "2427707", "date": "28.06. 2023"}, {"type": "PDF", "label": "5. Návrh energetiky, M 1 7500.pdf", "id": "365798", "url": "/eia/dokument/365798", "filesize": "2663772", "date": "28.06. 2023"}, {"type": "PDF", "label": "6. Návrh telekomunikácií, M 1 7500.pdf", "id": "365799", "url": "/eia/dokument/365799", "filesize": "2358458", "date": "28.06. 2023"}, {"type": "PDF", "label": "8. Krajinnoekologický plán a návrh MÚSES, M 1 15000.pdf", "id": "365765", "url": "/eia/dokument/365765", "filesize": "2398074", "date": "28.06. 2023"}, {"type": "PDF", "label": "9A Komplexný urbanistický návrh – záväzná časť riešenia a VP stavby, M 1 15000.pdf", "id"