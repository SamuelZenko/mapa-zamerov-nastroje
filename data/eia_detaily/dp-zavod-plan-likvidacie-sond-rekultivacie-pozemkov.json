{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/dp-zavod-plan-likvidacie-sond-rekultivacie-pozemkov", "@type": "EiaProject", "id": "142909", "seoId": "dp-zavod-plan-likvidacie-sond-rekultivacie-pozemkov", "name": "DP Závod – plán likvidácie sond a rekultivácie pozemkov", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "1.16", "label": "Vrty (okrem vrtov na skúmanie stability pôdy súvisiacich s tažobnou cinnostou) najmä: vrty na využívanie geotermálnej energie a geotermálnych vôd; vrty na uskladnenie rádioaktívneho odpadu; vrty pre vodné zdroje"}, {"num": "1.5", "label": "Tažba a úprava zemného plynu"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "V nadväznosti na záverečnú etapu ťažby plynu a gazolínu, postupne vzniká nevyužívaný fond sond a vrtov, ktoré nie je možné inak využívať, preto je potrebné navrhnúť takéto sondy a vrty na postupnú likvidáciu a na schválenie plánu rekultivácie dotknutých pozemkov. \r\nDôvody návrhu sond (vrtov) na likvidáciu: \r\n- sondy (vrty) sú úplne zavodnené a dlhodobo nevyužívané, \r\n- sondami (vrtmi) neboli zistené iné výhradné ložiská v DP Závod, \r\n- možnosť skúšania iných obzorov na sondách (vrtoch) nie je, \r\n- nie sú plánované pre účely uskladňovania. \r\nLikvidáciou sond a vrtov nebude ovplyvnená stávajúca činnosť v DP Závod, ktorá je zameraná na ťažbu horľavého zemného plynu. Táto činnosť je vykonávaná spoločnosťou NAFTA a.s. a v súčinnosti s geologickým a technologickým riadením ťažby vlastných zdrojov a je vykonávaná tak, aby boli racionálne využité všetky zložky ťažených nerastov.\r\n", "navrhovatel": {"name": "NAFTA a.s., Votrubova 1, 821 09 Bratislava", "ico": "36286192"}, "prislusnyOrgan": {"name": " Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Veľké Leváre, Závod (okres: Malacky)", "povolujuciOrgan": "1.\tObec Veľké Leváre, Obecný úrad Štefániková 747, 908 73 Veľké Leváre \r\n2.\tObec Závod, Obecný úrad Závod, Sokolská 243, 908 72 Závod\r\n", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zmena navrhovanej činnosti", "number": 1, "items": [{"title": "Informácia pre verejnosť", "items": [{"type": "PDF", "label": "Informácia pre verejnost DP Závod – plán likvidácie sond a rekultivácie pozemkov.pdf", "id": "276506", "url": "/eia/dokument/276506", "filesize": "391433", "date": "30.05. 2018"}]}, {"title": "Text oznámenia o zmene", "items": [{"type": "PDF", "label": "LV 1560_Závod.pdf", "id": "276474", "url": "/eia/dokument/276474", "filesize": "72797", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 260_Veľké_Leváre.pdf", "id": "276473", "url": "/eia/dokument/276473", "filesize": "92874", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 2469_Závod.pdf", "id": "276475", "url": "/eia/dokument/276475", "filesize": "56634", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 2697_Závod.pdf", "id": "276452", "url": "/eia/dokument/276452", "filesize": "78469", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 2786_Závod.pdf", "id": "276453", "url": "/eia/dokument/276453", "filesize": "82772", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 2792_Závod.pdf", "id": "276454", "url": "/eia/dokument/276454", "filesize": "53059", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 2862_Závod.pdf", "id": "276455", "url": "/eia/dokument/276455", "filesize": "79572", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 2864_Závod.pdf", "id": "276456", "url": "/eia/dokument/276456", "filesize": "53846", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 3048_Závod.pdf", "id": "276457", "url": "/eia/dokument/276457", "filesize": "97666", "date": "30.05. 2018"}, {"type": "PDF", "label": "LV 3049_Závod.pdf", "id": "276458", "url": "/eia/dokument/276458", "filesize": "97027", "date": "30.05. 