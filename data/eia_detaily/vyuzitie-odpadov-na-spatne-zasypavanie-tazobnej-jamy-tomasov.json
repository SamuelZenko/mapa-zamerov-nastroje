{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/vyuzitie-odpadov-na-spatne-zasypavanie-tazobnej-jamy-tomasov", "@type": "EiaProject", "id": "166508", "seoId": "vyuzitie-odpadov-na-spatne-zasypavanie-tazobnej-jamy-tomasov", "name": "Využitie odpadov na spätné zasypávanie ťažobnej jamy Tomášov", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.6", "label": "Zhodnocovanie ostatných odpadov okrem zhodnocovania odpadov uvedeného v položkách 5 a 11, zariadenia na úpravu a spracovanie ostatných odpadov"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "navrhovaná činnosť predstavuje rekultiváciu ťažobnej jamy nevyhradeného nerastu po ťažbe štrkopieskov inertným odpadom. Uvedená činnosť predstavuje využitie výkopovej zeminy, ktorá by sa v prípade nerealizacie navrhovanej činnosti podľa platnej legislatívy mala byť zneškodnená na skládke odpadov. účelom navrhovanej činnosti je navrhnúť konkrétne technologické opatrenia na revitalizáciu devastovaného územia a jeho uvedenia do funkčného stavu s parametrami pôdy čo najbližšími stavu pred neoprávneným zásahom, otvorením ťažby štrkov. ", "navrhovatel": {"name": "Enviro Tomasov s.r.o.,Lipová 713/22, 925 23 Hrubá Borša", "ico": "50930508"}, "prislusnyOrgan": {"name": " Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Tomášov (okres: Senec)", "povolujuciOrgan": "OU Senec-OSŽP\r\nObec Tomášov", "schvalujuciOrgan": "OÚ BA, obec Tomášov, OÚ Senec ", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Informácia pre verejnosť.pdf", "id": "362063", "url": "/eia/dokument/362063", "filesize": "157140", "date": "13.04. 2023"}, {"type": "PDF", "label": "Informácia pre verejnosť nové.pdf", "id": "36