{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-vinosady", "@type": "EiaProject", "id": "133960", "seoId": "uzemny-plan-obce-vinosady", "name": "Územný plán obce Vinosady", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 1"}], "proces": "Povinné hodnotenie", "cezhranicnaSpolupraca": null, "ucel": "Cieľom „ÚPN obce Vinosady“ je komplexné riešenie priestorového usporiadania a funkčného využitia územia, stanovenie zásad jeho organizácie a vecná a časová koordinácia jednotlivých činností v súlade s princípmi udržateľného rozvoja, podľa ustanovení § 1 Zákona č. 50/1976 v znení neskorších predpisov. Ciele a smerovanie rozvoja územia bude ÚPN podriaďovať ochrane a rozvoju životného prostredia, kultúrno-historických a prírodných hodnôt územia, pričom bude hľadať možnosti optimálneho využitia zdrojov a rezerv územia na jeho spoločensky najefektívnejší urbanistický rozvoj.", "navrhovatel": {"name": "Obec Vinosady, Obecný úrad Vinosady, Pezinská 95, 902 01 Vinosady", "ico": "508314"}, "prislusnyOrgan": {"name": "Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Pezinok, Vinosady, Šenkvice, Modra (okres: Pezinok)", "povolujuciOrgan": null, "schvalujuciOrgan": "obecné zastupiteľstvo obce Vinosady", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "1_UPN Vinosady_informácia o oznámení.pdf", "id": "259800", "url": "/eia/dokument/259800", "filesize": "134023", "date": "14.06. 2017"}]}, {"title": "Oznámenie", "items": [{"type": "JPG", "label": "Vinosady navrh Vykres 1.jpg", "id": "259789", "url": "/eia/dokument/259789", "filesize": "5973092", "date": "14.06. 2017"}, {"type": "PDF", "label": "UPN-O Vi