{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-pila-zmeny-doplnky-c-1-2023", "@type": "EiaProject", "id": "168210", "seoId": "uzemny-plan-obce-pila-zmeny-doplnky-c-1-2023", "name": "Územný plán obce Píla, zmeny a doplnky č. 1/2023", "zbierka": "24/2006 novela 372/2021 Z.z. časť SEA", "stav": "Záverečné stanovisko", "cinnosti": [{"num": null, "label": "podla § 4, ods. 1"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Hlavné ciele pre obstaranie dokumentácie na úrovni Územného plánu obce Píla Zmeny a doplnky č. 1/2023 sú nasledovné:\r\n- odsúhlasiť základný nástroj územného rozvoja a starostlivosti o životné prostredie, t. j. nástroj pre riadenie, usmerňovanie a regulovanie všetkých činností na území obce, ktorý komplexne rieši priestorové usporiadanie a funkčné využitie územia, stanovuje zásady jeho organizácie a vecnú  časovú koordináciu jednotlivých činností v súlade s princípmi udržateľného rozvoja, podľa ustanovení § 1 zákona č. 50/1976 Zb. o územnom plánovaní a stavebnom poriadku (stavený zákon) v znení neskorších predpisov,\r\n- premietnuť súčasné a predpokladané rozvojové zámery do územno-priestorového potenciálu obce tak, aby urbanistickou koncepciou riešenia bola zabezpečená a preukázaná komplexnosť a rozvojová únosnosť riešeného územia,\r\n- zosúladiť rozvojové a plánovacie dokumenty na úrovni vyšších územných celkov s rozvojovými zámermi obce,\r\n- stanoviť optimálny územný rozvoj pre bývanie v rodinných domoch, základnú občiansku vybavenosť, dopravnú a technickú infraštruktúru, formou intenzifikácie intravilánu a lokalít v kontakte zastavaného územia obce.", "navrhovatel": {"name": "Obec Píla, Hlavná 68, 900 89 Píla", "ico": "00305031"}, "prislusnyOrgan": {"name": " Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Píla (okres: Pezinok)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo Píla, Píla 68, 900 89 Píla", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Píla ZaD 01_2023 informácia o oznámení.pdf", "id": "367797", "url": "/eia/dokument/367797", "filesize": "210794", "date": "07.08. 2023"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Oznámenie o SD_ÚPN_O_Pila_1_2023.pdf", "id": "367796", "url": "/eia/dokument/367796", "filesize": "383600", "date": "07.08. 2023"}]}, {"title": "Rozhodnutie zo zisťovacieho konania", "items": [{"type": "PDF", "label": "Píla ZaD 01_2023 Rozhodnutie.pdf", "id": "378931", "url": "/eia/dokument/378931", "filesize": "1865176", "date": "22.04. 2024"}]}, {"title": "Text strategického dokumentu", "items": [{"type": "ZIP", "label": "ZaD Píla 01_2023.zip", "id": "367795", "url": "/eia/dokument/367795", "filesize": "46233001", "date": "07.08. 2023"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia", "items": [{"type": "PDF", "label": "Píla ZaD 01_2023 Rozsah hodnotenia.pdf", "id": "383415", "url": "/eia/dokument/383415", "filesize": "206748", "date": "06.09. 2024"}, {"type": "PDF", "label": "príloha 1_radónové riziko.pdf", "id": "383422", "url": "/eia/dokument/383422", "filesize": "399832", "date": "06.09. 2024"}]}, {"title": "Informácia o rozsahu hodnotenia", "items": [{"type": "PDF", "label": "ZaD 1_2023_Píla_informácia o vydaní rozsahu hodnotenia.pdf", "id": "383424", "url": "/eia/dokument/383424", "filesize": "99316", "date": "06.09. 2024"}]}]}, {"step": "Správa o hodnotení", "number": 3, "items": [{"title": "Informácia o správe o hodnotení", "items": [{"type": "PDF", "label": "Správa o hodnotení  ZaD Píla 1_2023_info pre verejnosť.pdf", "id": "399795", "url": "/eia/dokument/399795", "filesize": "105390", "date": "21.01. 2026"}]}, {"type": "text", "label": "Spracovateľ správy o hodnotení", "val