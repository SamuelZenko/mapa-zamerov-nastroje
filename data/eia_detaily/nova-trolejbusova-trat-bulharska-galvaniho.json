{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/nova-trolejbusova-trat-bulharska-galvaniho", "@type": "EiaProject", "id": "166862", "seoId": "nova-trolejbusova-trat-bulharska-galvaniho", "name": "Nová trolejbusová trať Bulharská - Galvaniho", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "13.9", "label": "Elektrické dráhy, závesné dráhy alebo podobné dráhy osobitného druhu a trolejbusové dráhy"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Hlavným účelom navrhovanej činnosti je predĺženie existujúcej trolejbusovej trate v MČ Ružinov v časti Trnávka po ulici Bulharská k ulici Galvaniho s pokračovaním vpravo po tejto ulici až k nákupnému centru Avion Shopping Park a prostredníctvom hybridných trolejbusov ďalej až na Letisko M. R. Štefánika.\r\nCieľom navrhovanej činnosti je skvalitniť a rozšíriť služby MHD na území mesta Bratislava prostredníctvom modernizácie a rozvoja trolejbusovej dopravy, saturovať nároky cestujúcej verejnosti na prepravné kapacity, zlepšiť dopravnú obslužnosť dotknutej oblasti, znížiť dopravné zaťaženie v riešenej oblasti a prispieť k zabezpečeniu udržateľnejšej a ekologickejšej mobility v meste a k zlepšeniu kvality životného prostredia.\r\n", "navrhovatel": {"name": "Dopravný podnik Bratislava, a.s.", "ico": "00492736"}, "prislusnyOrgan": {"name": " Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislava - Ružinov (okres: Bratislava II)", "povolujuciOrgan": "MČ BA RUŽINOV, OÚ BA", "schvalujuciOrgan": "BSK špeciálny stavebný úrad, OÚ BA odbor cestnej dopravy a pozemných komunikácií, Hlavné mesto SR Bratislava, MČ BA Ružinov", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "1. Informácia pre verejnosť Nová trolejbusova trat Bulharska Galvaniho.pdf", "id": "347697", "url": "/eia/dokument/347697", "filesize": "166239", "date": "30.06. 2022"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "REMING CONSULT, a.s."}, {"title": "Text zámeru", "items": [{"type": "ZIP", "label": "PDF.zip", "id": "347696", "url": "/eia/dokument/347696", "filesize": "21342002", "date": "30.06. 2022"}, {"type": "PDF", "label": "Doplňujúce informácie (Nová trolejbusová trať Bulharská - Galvaniho).pdf", "id": "356906", "url": "/eia/dokument/356906", "filesize": "3499461", "date": "29.12. 2022"}]}, {"title": "Rozhodnutie pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "Rozhodnutie_Nová trolejbusová trať Bulharská - Galvaniho.pdf", "id": "360003", "url": "/eia/dokument/360003", "filesize": "19326049", "date": "08.03. 2023"}]}, {"title": "Právoplatné rozhodnutie", "items": [{"type": "PDF", "label": "Právoplatné rozhodnutie_Nová trolejbusová trať Bulharská_Galvaniho.pdf", "id": "362073", "url": "/eia/dokument/362073", "filesize": "2600443", "date": "14.04. 2023"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťovacie konanie", "link": "/eia/zistovacie-konanie", "children": []}, {"id": 7725, "parentId": 7722, "name": "Konanie o podnete", "link": "/eia/kona