{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/program-hospodarskeho-rozvoja-socialneho-rozvoja-mikroregionu-cerveny-", "@type": "EiaProject", "id": "166355", "seoId": "program-hospodarskeho-rozvoja-socialneho-rozvoja-mikroregionu-cerveny-", "name": "Program hospodárskeho rozvoja a sociálneho rozvoja Mikroregiónu Červený Kameň na roky 2021 – 2027 s výhľadom do roku 2030", "zbierka": "24/2006 novela 372/2021 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Mikroregión Červený Kameň bude zabezpečovať dobré podmienky pre život a rozvoj obyvateľov, podnikateľov a návštevníkov; a to hlavne vybudovaním spoločného rámca samospráv pre zabezpečovanie kompetencií, inovatívnym prístupom a aktivizovaním obyvateľov. Takto zabezpečí rozvoj kľúčových oblastí, ktorými sú: kvalitné životné prostredie, aktívna komunita a rozvíjajúca sa lokálna ekonomika.\r\nNastavenie celého strategického rámca berie do úvahy výsledky analýzy potenciálu, limitov či problémov v regióne, globálne trendy a vývoj, ktorý je ovplyvňovaný vonkajšími vplyvmi. Tento cieľ vyjadruje nielen to, na čo sa budú ďalšie aktivity orientovať (stanovenie priorít), ale vyjadruje aj spôsob, akým sa bude na tieto aktivity nazerať, aby sme mohli dosiahnuť želaný rozvoj. Budovanie spolupráce, inovatívne prístupy a aktivizácia obyvateľov predstavujú kľúčové princípy, ktoré sú prierezové a budú sa aplikovať v každej priorite pri hľadaní riešení stanovených problémov, limitov či výziev.", "navrhovatel": {"name": "Mikroregión Červený Kameň, združenie obcí, Hlavná 168, 900 89 Častá", "ico": "30795915"}, "prislusnyOrgan": {"name": "Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Doľany, Báhoň, Plavecké Podhradie, Častá, Budmerice, Cífer, Vištuk, Jablonec, Lošonec, Rohožník, Štefanová, Sološnica, Šenkvice, Kaplna, Dlhá, Blatné, Píla, Dolné Orešany, Ružindol, Dubová, Modra, Borová (okresy: Pezinok, Malacky, Trnava, Senec)", "povolujuciOrgan": null, "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "1_PHRSR MČK_informácia pre verejnosť.pdf", "id": "339998", "url": "/eia/dokument/339998", "filesize": "131359", "date": "18.02. 2022"}, {"type": "PDF", "label": "1_PHRSR MČK_informácia pre verejnosť_doplnenie.pdf", "id": "350865", "url": "/eia/dokument/350865", "filesize": "131445", "date": "07.09. 2022"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Oznámenie o strategickom dokumente_PHRSRMČK.pdf", "id": "339987", "url": "/eia/dokument/339987", "filesize": "904463", "date": "18.02. 2022"}, {"type": "PDF", "label": "1_Oznámenie_PHRSRMČK_Graf.príloha.pdf", "id": "350864", "url": "/eia/dokument/350864", "filesize": "1402874", "date": "07.09. 2022"}, {"type": "PDF", "label": "1_Oznámenie o strat.dokumente_doplnené_0722.pdf", "id": "350863", "url": "/eia/dokument/350863", "filesize": "676830", "date": "07.09. 2022"}]}, {"title": "Rozhodnutie zo zisťovacieho konania", "items": [{"type": "PDF", "label": "PHRSR MČK 2021_2027_Rozhodnutie_rovnopis.pdf", "id": "355417", "url": "/eia/dokument/355417", "filesize": "3809058", "date": "02.12. 2022"}]}, {"title": "Text strategického dokumentu", "items": [{"type": "PDF", "label": "Príloha 2 Kultúrno-spoločenské a športové podujatia.pdf", "id": "339990", "url": "/eia/dokument/339990", "filesize": "130230", "date": "18.02. 2022"}, {"type": "PDF", "label": "Extrakt z PHRSR Stratégia rozvoja cestovného ruchu pre MČK.pdf", "id": "339997", "url": "/eia/dokument/339997", "filesize": "538106", "date": "18.02. 2022"}, {"type": "PDF", "label": "Extrakt z PHRSR Plán odpadového hospodárstva pre MČK.pdf", "id": "339996", "url": "