{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-miloslavov-zmeny-doplnky-c-1-2013", "@type": "EiaProject", "id": "114224", "seoId": "uzemny-plan-obce-miloslavov-zmeny-doplnky-c-1-2013", "name": "Územný plán obce Miloslavov-Zmeny a doplnky č. 1/2013", "zbierka": "24/2006 novela 408/2011 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Cieľom riešenia \"Zmiena doplnkov č. 1/2013\" je: komplexná úprava zásad a regulatívov v záväznej časti, zakreslenie skutkového stavu podľa aktuálnych podkladov, umiestnenie nových rozvojových lokalít  mimo zastavaného územia obce a v zastavanom území obce, potreba zosúladenia ÚPN obce s ÚPN-R BSK, rehodnotenie regulácie územia vo všetkých ostatných existujúcich aj rozvojových lokalitách v zmysle platného ÚPN, umiestnenie líniových a bodových stavieb dopravnej a technickej vybavenosti.", "navrhovatel": {"name": "Obec Miloslavov, Alžbetin dvor 181, 900 42 Miloslavov", "ico": "00508098"}, "prislusnyOrgan": {"name": "Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Miloslavov (okres: Senec)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zatupiteľstvo obce Miloslavov", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "RTF", "label": "Informácia o oznámení - Oznámenie /S/", "id": "213817", "url": "/eia/dokument/213817", "filesize": "3262", "date": "27.05. 2014"}]}, {"title": "Oznámenie", "items": [{"type": "JPG", "label": "Výkres 2", "id": "213830", "url": "/eia/dokument/213830", "filesize": "8949163", "date": "27.05. 2014"}, {"type": "JPG", "label": "Výkres 9", "id": "213815", "url": "/eia/dokument/213815", "filesize": "5966115", "date