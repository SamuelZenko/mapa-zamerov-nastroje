{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/zmeny-doplnky-c-3-2021-uzemneho-planu-obce-vysoka-pri-morave", "@type": "EiaProject", "id": "164776", "seoId": "zmeny-doplnky-c-3-2021-uzemneho-planu-obce-vysoka-pri-morave", "name": "Zmeny a doplnky č. 3/2021 Územného plánu obce Vysoká pri Morave", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Zmena strategického dokumentu na využitie malého územia na miestnej úrovni.\r\nPri „otvorení“ ÚPN-O obce Vysoká pri Morave sa vytipovali všetky momentálne požiadavky na možnosti novej zástavby v katastri obce v záujme jej tabilizácie. Jedná sa o požiadavky na aktivity v oblasti rozvoja individuálnej chalupárskej rekreácie, lokálneho nemasového turizmu a športu so zdôraznením chovu ušľachtilých domácich zvierat ( chov dostihových koní ). Zároveň sa vytipovali iné potreby malých drobných zmien v územno-plánovacej dokumentácii pre potreby rozvoja miestnych aktivít.", "navrhovatel": {"name": "Obec Vysoká pri Morave, Obecný úrad, Hlavná 196, 900 66 Vysoká pri Morave", "ico": "00305197"}, "prislusnyOrgan": {"name": "Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Vysoká pri Morave (okres: Malacky)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo pri Obecnom úrade Vysoká pri Morave", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia k ZaD č. 3_2021 Územného plánu obce Vysoká pri Morave.pdf", "id": "321906", "url": "/eia/dokument/321906", "filesize": "749893", "date": "04.03. 2021"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "ZaD3_2021_strat