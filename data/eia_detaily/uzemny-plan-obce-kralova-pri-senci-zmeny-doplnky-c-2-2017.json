{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-kralova-pri-senci-zmeny-doplnky-c-2-2017", "@type": "EiaProject", "id": "134962", "seoId": "uzemny-plan-obce-kralova-pri-senci-zmeny-doplnky-c-2-2017", "name": "Územný plán obce Kráľová pri Senci - Zmeny a doplnky č. 2/2017", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Cieľp, riešenie \"zmien a doplnkov č. 2/2017\" je najmä umiestnenie nových rozvojových plôch. zmeny funkčného využitia rozvojových plôch, umietnneie zámerov líniových a bodových stavieb doprvnej a technickej vybavenosti, vymedzenie existujúcich a navrhovaných funkčných plôch, zakreslenie skutkového stavu podľa akutálnych podkldov, komplexná úprava zásad a regulatívov v záväznej textovej časti, odstránenie nezrovnalostí v grafickom spracovaní platného ÚPN a úpravy grafického zobrazenia, zosúladenie ÚPN obce s nadredenou dokumentáciou ÚPN regiónu BSK.", "navrhovatel": {"name": "Obec kráľová pri Senci, Obecný úrad Kráľová pri Senci, 900 50 Kráľová pri Senci 326", "ico": "00503894"}, "prislusnyOrgan": {"name": "Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Kráľová pri Senci (okres: Senec)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Verejnost Králová.pdf", "id": "261598", "url": "/eia/dokument/261598", "filesize": "205155", "date": "25.07. 2017"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "KPS ZaD 2 Oznámenie o strateg.dok..pdf", "id": "261597", "url": "/eia/dokument/261597", "filesize": "812134", "date": "2