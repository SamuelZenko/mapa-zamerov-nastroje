 LAKE RELAX LOZORNO jul 2017.pdf", "id": "262243", "url": "/eia/dokument/262243", "filesize": "4611348", "date": "07.08. 2017"}]}, {"title": "Prerušenie/zastavenie konania", "items": [{"type": "PDF", "label": "Zastavenie konania.pdf", "id": "268871", "url": "/eia/dokument/268871", "filesize": "1344091", "date": "28.12. 2017"}]}]}, {"step": "Iný dôvod ukončenia", "number": 2, "items": [{"title": "Späť vzatie návrhu", "items": [{"type": "PDF", "label": "zastavenie-konania-.pdf", "id": "345879", "url": "/eia/dokument/345879", "filesize": "1344091", "date": "28.12. 2022"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťovacie konanie", "link": "/eia/zistovacie-konanie", "children": []}, {"id": 7725, "parentId": 7722, "name": "Konanie o podnete", "link": "/eia/konanie-o-podnete", "children": []}, {"id": 7726, "parentId": 7722, "name": "Odborné stanovisko orgánu ochrany prírody a krajiny", "link": "/eia/odborne-stanovisko", "children": []}]}, {"id": 7727, "parentId": 7843, "name": "Ako prebieha EIA?", "link": "#", "children": [{"id": 7728, "parentId": 7727, "name": "Prehľad krokov", "link": "/eia/priebeh-procesu", "children": []}, {"id": 7729, "parentId": 7727, "name": "1. KROK – Informácia o navrhovanej činnosti alebo jej zmene", "link": "/eia/navrhovana-cinnost", "children": []}, {"i