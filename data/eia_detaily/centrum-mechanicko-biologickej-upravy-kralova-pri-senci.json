{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/centrum-mechanicko-biologickej-upravy-kralova-pri-senci", "@type": "EiaProject", "id": "167912", "seoId": "centrum-mechanicko-biologickej-upravy-kralova-pri-senci", "name": "Centrum mechanicko-biologickej úpravy Kráľová pri Senci", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Rozsah hodnotenia", "cinnosti": [{"num": "9.6", "label": "Zhodnocovanie ostatných odpadov okrem zhodnocovania odpadov uvedeného v položkách 5 a 11, zariadenia na úpravu a spracovanie ostatných odpadov"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovanej činnosti je mechanicko-biologická úprava zvyškových odpadov, po prechádzajúcom triedení odpadov pri zdroji ich vzniku, ktorá bude prebiehať prevažne v uzavretých priestoroch. Výsledkom tejto činnosti bude biologická úprava biologicky rozložiteľnej zložky odpadov, pred jej následným zhodnotením a získanie materiálovo a energeticky využiteľných zložiek z odpadu, ktorý by bol inak určený predovšetkým na zneškodnenie na skládkach odpadov. Koncept navrhovaného zariadenia na mechanicko – biologickú úpravu odpadov je navrhnutý s dôrazom na zabezpečenie 100%-ného zhodnotenia výstupných odpadov, resp. na uplatňovanie moderného, tzv. „zero waste to landfill“ prístupu (nulového odpadu na skládku) v systéme odpadového hospodárstva, resp. nakladania s odpadmi. Technologické zariadenie navrhovanej činnosti bude využívané pre činnosť zhodnocovania odpadov v podobe ich úpravy, ktorá spočíva vo vytriedení odpadov prijímaných do zariadenia, vytriedení biologicky rozložiteľnej zložky odpadu a jej následnej biologickej úprave a vo vytriedení materiálovo a energeticky využiteľných odpadov, pre ich následné materiálové a energetické zhodnotenie. Výsledným účelom navrhovanej činnosti je teda maximálna eliminácia vzniku nevyužiteľných odpadov, ktoré by inak museli byť predovšetkým zneškodňované umiestňovaním na riadených skládkach nie nebezpečných odpadov. Navrhovaná činnosť mechanicko – biologickej úpravy odpadov bude riešiť otázku nakladania s odpadmi, v rámci regiónu Bratislavského samosprávneho kraja a jeho okolia, pre ich následné materiálové a energetické využitie.", "navrhovatel": {"name": "KOSIT WEST s.r.o.", "ico": "50492471"}, "prislusnyOrgan": {"name": "Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Tureň, Hrubý Šúr, Kráľová pri Senci, Senec, Kostolná pri Dunaji (okres: Senec)", "povolujuciOrgan": "Obec Kráľová pri Senci, Slovenská išpekcia životného prostredia, Inšpektorát životnéo prostredia, odbor integrovaného povoľovania a kontroly", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Informácia pre verejnosť.pdf", "id": "363472", "url": "/eia/dokument/363472", "filesize": "232580", "date": "16.05. 2023"}, {"type": "PDF", "label": "Vyjadrenie navrhovateľa k podkladom k podkladom rozhodnutia a návrh na jeho doplnenie.pdf", "id": "369372", "url": "/eia/dokument/369372", "filesize": "2649440", "date": "13.09. 2023"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "Mgr. Alexander Starinský, Rastislavova 98, 043 46 Košice"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "Príloha 4.pdf", "id": "363441", "url": "/eia/dokument/363441", "filesize": "6015758", "date": "16.05. 2023"}, {"type": "PDF", "label": "Príloha 2.pdf", "id": "363423", "url": "/eia/dokument/363423", "filesize": "5234425", "date": "16.05. 2023"}, {"type": "PDF", "label": "Príloha 3.pdf", "id": "363440", "url": "/eia/dokument/363440", "filesize": "896816", "date": "16.05. 2023"}, {"type": "PDF", "label": "Zámer navrhovanej činnosti.pdf", "id": "363422", "url": "/eia/dokument/363422", "filesize": "2656621", "date": "16.05. 2023"}, {"type": "PDF", "label": "Príloha 5.pdf", "id": "363442", "url": "/eia/dokument/363442", "filesize": "9053851", "date": "16.05. 2023"}]}, {"title": "Rozhodnutie pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "rozhodnutie centrum MBU Kralova pri Senci.pdf", "id": "371330", "url": "/eia/dokument/371330", "filesize": "668385", "date": "25.10. 2023"}]}, {"title": "Odvolanie/ rozklad proti rozhodnutiu", "items": [{"type": "PDF", "label": "Podaný rozklad / odvolanie", "id": "372042", "url": "/eia/dokument/372042", "filesize": "189962", "date": "09.11. 2023"}, {"type": "PDF", "label": "Informácia pre verejnosť o odvolaní alebo rozklade", "id": "372043", "url": "/eia/dokument/372043", "filesize": "397238", "date": "09.11. 2023"}, {"type": "PDF", "label": "Rozhodnutie odvolacieho orgánu", "id": "376365", "url": "/eia/dokument/376365", "filesize": "526550", "date": "21.02. 2024"}]}, {"title": "Právoplatné rozhodnutie", "items": [{"type": "PDF", "label": "pravoplatne rozhodnutie.pdf", "id": "377609", "url": "/eia/dokument/377609", "filesize": "752133", "date": "22.03. 2024"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia navrhovanej činnosti", "items": [{"type": "PDF", "label": "zverejnenie verejnej vyhlášky.pdf", "id": "379443", "url": "/eia/dokument/379443", "filesize": "450474", "date": "10.05. 2024"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti p