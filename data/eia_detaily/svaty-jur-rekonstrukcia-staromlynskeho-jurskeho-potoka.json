{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/svaty-jur-rekonstrukcia-staromlynskeho-jurskeho-potoka", "@type": "EiaProject", "id": "150169", "seoId": "svaty-jur-rekonstrukcia-staromlynskeho-jurskeho-potoka", "name": "Svätý Jur – rekonštrukcia Staromlynského (Jurského) potoka", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "10.7", "label": "Objekty protipovodnovej ochrany"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovanej činnosti je rekonštrukcia koryta Jurského potoka a čiastočne jeho 2 bezmenných ľavostranných prítokov tak, aby sa zabezpečil bezpečný prechod veľkých vôd do prietokov Q = 6 m3.s-1 cez zastavané územie mesta Svätý Jur a tým aj je adekvátna protipovodňová ochrany mesta Svätý Jur (Účelom rekonštrukcie potoka je zabezpečiť bezpečný prechod veľkých vôd. Nutnosť rekonštrukcie je daná nevyhovujúcou kapacitou koryta Jurského potoka a čiastočne jeho bezmenného ľavostranného prítoku a ich objektov. Účelom stavby po rekonštrukcii je zabezpečiť, aby koryto potoka previedlo požadovaný prietok pri prechode veľkých vôd. Realizovaná rekonštrukcia Jurského potoka a čiastočne jeho 2 bezmenných ľavostranných prítokov dáva predpoklad ďalšieho rozvoja v dotknutom území, doteraz ohrozovaného povodňami.", "navrhovatel": {"name": "SLOVENSKÝ VODOHOSPODÁRSKY PODNIK, štátny podnik, Odštepný závod Bratislava, Karloveská č. 2, 842 17 Bratislava", "ico": "36022047"}, "prislusnyOrgan": {"name": " Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Svätý Jur (okres: Pezinok)", "povolujuciOrgan": "OÚ Pezinok, OSZP", "schvalujuciOrgan": "OÚ Pezinok, OSZP", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Re