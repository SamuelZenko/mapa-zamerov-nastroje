{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-vysoka-pri-morave-zmeny-doplnky-c-2-2017", "@type": "EiaProject", "id": "141125", "seoId": "uzemny-plan-obce-vysoka-pri-morave-zmeny-doplnky-c-2-2017", "name": "Územný plán obce Vysoká pri Morave, Zmeny a doplnky č. 2/2017", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Dôvodom pre obstaranie Zmien a doplnkov č. 2/2017 územného plánu obce Vysoká pri Morave sú aktuálne požiadavky vlastníkov jednotlivých pozemkov na zmenu funkčného alebo dimenzionálneho využitia územia týchto plôch, nachádzajúcich sa v zastavanej časti   katastrálneho územia obce Vysoká pri Morave. Ďalší dôvod je demografický vývoj obce, čo sa týka počtu obyvateľov,  ich veku a nárokov na jednotlivé funkcie území.  ", "navrhovatel": {"name": "Obec Vysoká pri Morave, Obecný úrad Vysoká pri Morave, Hlavná    č. 196/102, 900 66 Vysoká pri Morave ", "ico": "00305197"}, "prislusnyOrgan": {"name": "Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Vysoká pri Morave (okres: Malacky)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo pri Obecnom úrade Vysoká pri Morave  ", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia k Územný plán obce Vysoká pri Morave, Zmeny a doplnky c. 2_2017.pdf", "id": "273215", "url": "/eia/dokument/273215", "filesize": "203296", "date": "21.03. 2018"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "6_LOKALITA 2_NOVA FUNKCIA_A3.pdf", "id": "273209", "url": "/eia/dokument/273209", "filesize": "321773", "date": "21.03. 2018"}, {"ty