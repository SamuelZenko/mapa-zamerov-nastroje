{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/svaty-jur-protipovodnova-ochrana-poldre", "@type": "EiaProject", "id": "155491", "seoId": "svaty-jur-protipovodnova-ochrana-poldre", "name": "Svätý Jur - protipovodňová ochrana, Poldre", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Rozsah hodnotenia", "cinnosti": [{"num": "10.1", "label": "Priehrady, nádrže a iné zariadenia urcené na zadržiavanie alebo na akumuláciu vody vrátane suchých nádrží - s výškou hrádze nad základovou líniou alebo - s celkovým novým objemom alebo dodatocne zadržaným objemom - s rozlohou"}, {"num": "10.7", "label": "Objekty protipovodnovej ochrany"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovaných činností je zabezpečenie ochrany zastavaného územia mesta Svätý Jur pred ničivými účinkami povodňových prietokov cez jeho územie.Tento zámer navrhovanej činnosti rieši kumulatívne pôsobenie troch navrhovaných poldrov na Jurskom potoku rkm 3,4, na ľavostrannom prítoku v rkm 3,3 Jurského potoka – Jozefkovo údolie a na ľavostrannom prítoku v rkm 2,5 Jurského potoka – Hradištná, ktoré sa majú nachádzať nad zastavaným územím mesta Svätý Jur, čo dáva predpoklad ďalšieho rozvoja v dotknutom území,doteraz ohrozovaného povodňami, ako aj výmenu existujúceho priepustu DN 600 za DN 1000 na prítoku bezmenného ľavostranného prítoku Jurského potoka do vodnej nádrže od navrhovaného poldra na ľavostrannom prítoku v rkm 3,3 Jurského potoka – Jozefkovo údolie, úpravu bezmenného prítoku pod navrhovaným poldrom na ľavostrannom prítoku v rkm 2,5 Jurského potoka – Hradištná v rkm 0,325 - 0,372 a revitalizáciu približne 142 m kanalizovaného úseku Jurského potoka medzi areálom Horského hotela Eva (úsek popri kúpalisku, tenisovom kurte a parkovisku) a lesnými spoločenstvami s cieľom vytvorenia náhradného biotopu pre raka riavového počas výstavby a prevádzky navrhovaných poldrov.", "navrhovatel": {"name": "SLOVENSKÝ VODOHOSPODÁRSKY PODNIK, štátny podnik, Odštepný závod Bratislava, Karloveská č. 2, 842 17 Bratislava", "ico": "36022047"}, "prislusnyOrgan": {"name": "Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Svätý Jur (okres: Pezinok)", "povolujuciOrgan": "Stavebný úrad mesta Svätý Jur a Okresný úrad Pezinok, odbor starostlivosti o životné prostredie", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Poldre Svätý Jur_info pre verejnosť.pdf", "id": "301058", "url": "/eia/dokument/301058", "filesize": "157992", "date": "09.12. 2019"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "EKO – GEO – CER, s. r. o., M. C. Sklodowskej 1512/19, 851 04 Bratislava"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "zamer_3poldre_sv_Jur.pdf", "id": "301074", "url": "/eia/dokument/301074", "filesize": "30661680", "date": "09.12. 2019"}, {"type": "PDF", "label": "Posúdenie zámeru - dodatok.pdf", "id": "385380", "url": "/eia/dokument/385380", "filesize": "337801", "date": "15.02. 2024"}]}, {"title": "Rozhodnutie pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "Poldre Svätý Jur_rozhodnutie.pdf", "id": "391811", "url": "/eia/dokument/391811", "filesize": "405587", "date": "21.05. 2025"}]}, {"title": "Právoplatné rozhodnutie", "items": [{"type": "PDF", "label": "Rozhodnutie_478_2025_Poldre Svätý Jur_právoplatné.pdf", "id": "393037", "url": "/eia/dokument/393037", "filesize": "459930", "date": "02.07. 2025"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia navrhovanej činnosti", "items": [{"type": "PDF", "label": "Rozsah hodnotenia_Poldre Svätý Jur_491_2026.pdf", "id": "400918", "url": "/eia/dokument/400918", "filesize": "387618", "date": "26.02. 2026"}]}]}]}, "blocks":