{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/truck-centrum-senec", "@type": "EiaProject", "id": "136782", "seoId": "truck-centrum-senec", "name": "Truck Centrum Senec", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.16", "label": "Projekty rozvoja obcí vrátane a) pozemných stavieb alebo ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy b) statickej dopravy c) územných plánov zóny, ktoré nahrádzajú územné rozhodnutie pre cinnosti uvedené v písmenách a) a b)"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovaného zámeru je výstavba dopravného areálu s príslušnou infraštruktúrou. Areál bude poskytovať služby pre motoristov predchádzajúcich hodnoteným územím (objekt čerpacej stanice pohonných látok s príslušnou infraštruktúrou a predovšetkým pre motoristov nákladných vozidiel, ktorí sa podieľajú na zásobovaní jednotlivých objektov logistického parku Senec (objekty sociálno-spoločenského zázemia).", "navrhovatel": {"name": "GEOSET-Inžiniering, s.r.o., Námestie SNP 19, 811 01 Bratislava", "ico": "36652369"}, "prislusnyOrgan": {"name": " Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Senec (okres: Senec)", "povolujuciOrgan": "Mesto Senec a Okresný úrad Senec, odbor starostlivosti o životné prostredie", "schvalujuciOrgan": "Mesto Senec a Okresný úrad Senec, odbor starostlivosti o životné prostredie", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Informácia pre verejnost  Truck Centrum Senec.pdf", "id": "265244", "url": "/eia/dokument/265244", "filesize": "218246", "date": "13.10. 2017"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "Aquifer"}, {"title": "Text záme