{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/strategia-bratislava-smart-region", "@type": "EiaProject", "id": "165199", "seoId": "strategia-bratislava-smart-region", "name": "Stratégia Bratislava SMART Region", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Iný dôvod ukončenia posudzovania", "cinnosti": [{"num": null, "label": "podla § 4, ods. 1"}], "proces": "Povinné hodnotenie", "cezhranicnaSpolupraca": null, "ucel": "Cieľom Stratégie Bratislava SMART Region je zadefinovanie a navrhnutie opatrení v zmysle kompetencií Úradu BSK a navrhnutie spôsobu, akým môžu jednotlivé odbory BSK efektívnejšie napĺňať svoje sektorové politiky a skvalitňovať verejné služby voči obyvateľom kraja. SMART stratégia zároveň zmapuje existujúce a možné optimalizačné, technické a technologické riešenia vrátane „Internetu vecí“ (IoT) technológie vo verejnom priestore. Súčasťou stratégie bude SWOT analýza spracovaná pre každú verejnú politiku alebo verejnú službu, v rámci ktorej sa predpokladá implementácia SMART prístupu. ", "navrhovatel": {"name": "Bratislavský samosprávny kraj, Sabinovská 16, 820 05 Bratislava 25", "ico": "36063606"}, "prislusnyOrgan": {"name": "Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislavský Kraj ", "povolujuciOrgan": null, "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "info o oznameni pre verejnost .pdf", "id": "323108", "url": "/eia/dokument/323108", "filesize": "219884", "date": "09.04. 2021"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "SEA_SMART_region_BSK.pdf", "id": "323103", "url": "/eia/dokument/323103", "filesize": "645612", "date": "09.04. 2021"}, {"type": "PDF", "label": "SMARTregion_oznamenie_list_OUŽP.pdf", "id