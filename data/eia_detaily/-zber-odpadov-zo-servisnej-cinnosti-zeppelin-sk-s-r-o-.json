{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/-zber-odpadov-zo-servisnej-cinnosti-zeppelin-sk-s-r-o-", "@type": "EiaProject", "id": "165989", "seoId": "-zber-odpadov-zo-servisnej-cinnosti-zeppelin-sk-s-r-o-", "name": ",,Zber odpadov zo servisnej činnosti Zeppelin SK s.r.o.“ ", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.10", "label": "Zhromažďovanie odpadov zo železných kovov a z neželezných kovov a starých vozidiel, - okrem zhromažďovania odpadov zo zálohovaných jednorazových obalov na nápoje z kovu"}, {"num": "9.9", "label": "Stavby, zariadenia, objekty a priestory na nakladanie s nebezpečnými odpadmi"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "V rámci servisnej činnosti navrhovateľ bude vykonávať servisnú činnosť tzv. in situ /poľný servis/ na mieste umiestnenia strojného zariadenia u zákazníka, resp. v mieste umiestnenia – vykonávania práce daného strojného zariadenia s následným prevzatím, respektíve zberom odpadov, ktoré pri tejto servisnej činnosti in situ vzniknú.\r\nZa daným účelom chce navrhovateľ využiť výlučne objekt, „Prevádzkový areál Zeppelin SK Bratislava, Triblavina“, pozemok parc. č. 5126/10, 5126/1, 5129/1, 5126/9, 5129/17 k. ú. Bernolákovo vo svojom vlastníctve, ktorý z hľadiska zabezpečenia životného prostredia v plnom rozsahu bude vyhovovať danej činnosti.\r\n", "navrhovatel": {"name": "Zeppelin SK s.r.o., Zvolenská cesta 14605/50, Banská Bystrica – Kráľová 974 05", "ico": "31579710"}, "prislusnyOrgan": {"name": " Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Bernolákovo (okres: Senec)", "povolujuciOrgan": "Obec Bernolákovo, Okresný úrad Senec", "schvalujuciOrgan": "Obec Bernolákovo, Okresný úrad Senec", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items