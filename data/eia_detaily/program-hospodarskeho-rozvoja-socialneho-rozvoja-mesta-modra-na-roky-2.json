{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/program-hospodarskeho-rozvoja-socialneho-rozvoja-mesta-modra-na-roky-2", "@type": "EiaProject", "id": "170289", "seoId": "program-hospodarskeho-rozvoja-socialneho-rozvoja-mesta-modra-na-roky-2", "name": "Program hospodárskeho rozvoja a sociálneho rozvoja mesta Modra na roky 2022 – 2027", "zbierka": "24/2006 novela 350/2024 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Vypracovanie PHRSR je dôležité pre dosiahnutie využitia strategického plánovania na území obce, lepšiu implementáciu rozvojových aktivít a zvyšovanie konkurencieschopnosti a efektivity pri čerpaní z fondov Európskej únie v rámci aktuálnych operačných programov. V prípade tvorby\r\ntohto programového dokumentu je dôležitá participácia verejnosti v procese tvorby PHRSR, čím sa zabezpečí spätná väzba a dosiahne sa konsenzu. Participovaním obyvateľov a záujmových skupín sa dosiahne vhodná implementácia rozvojových aktivít, ktoré podporia všeobecnú atraktivitu územia obce. Pri stanovovaní cieľov a rozvojových aktivít je nutné prihliadať na ciele a priority dokumentu Národná stratégia regionálneho rozvoja Slovenskej republiky.\r\n", "navrhovatel": {"name": "Mesto Modra, Mestský úrad Modra, Dukelská 38, 900 01 Modra", "ico": "00304956"}, "prislusnyOrgan": {"name": "Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Doľany, Pezinok, Vinosady, Vištuk, Rohožník, Kuchyňa, Šenkvice, Modra, Dubová (okresy: Pezinok, Malacky)", "povolujuciOrgan": null, "schvalujuciOrgan": "Mestské zastupiteľstvo mesta Modra", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "PHRSR Modra_informácia pre verejnosť.pdf", "id": "392011", "url": "/eia/dokument/392011", "filesize": "104428", "date": "29.05. 2025"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Oznamenie  PHRSR.pdf", "id": "392009", "url": "/eia/dokument/392009", "filesize": "349617", "date": "29.05. 2025"}, {"type": "PDF", "label": "Oznamenie PHRSR _informácia k doplneniu.pdf", "id": "393659", "url": "/eia/dokument/393659", "filesize": "129332", "date": "24.07. 2025"}, {"type": "PDF", "label": "Oznamenie PHRSR _doplnené.pdf", "id": "393658", "url": "/eia/dokument/393658", "filesize": "355993", "date": "24.07. 2025"}, {"type": "PDF", "label": "Modra_doplňujúce informácie.pdf", "id": "395126", "url": "/eia/dokument/395126", "filesize": "147601", "date": "11.09. 2025"}]}, {"title": "Rozhodnutie zo zisťovacieho konania", "items": [{"type": "PDF", "label": "PHRSR Modra 2022-2027_rozhodnutie.pdf", "id": "395282", "url": "/eia/dokument/395282", "filesize": "388369", "date": "17.09. 2025"}]}, {"title": "Text strategického dokumentu", "items": [{"type": "PDF", "label": "program-hospodarskeho-rozvoja-a-socialneho-rozvoja-modra-aktualizácia 04_2025.pdf", "id": "392010", "url": "/eia/dokument/392010", "filesize": "29091424", "date": "29.05. 2025"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "