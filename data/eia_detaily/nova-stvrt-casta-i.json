{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/nova-stvrt-casta-i", "@type": "EiaProject", "id": "116441", "seoId": "nova-stvrt-casta-i", "name": "Nová štvrť Častá I", "zbierka": "24/2006 novela 408/2011 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.14", "label": "Podzemné sklady s kapacitou a) zemného plynu a iných plynných médií b) ropy a petrochemických výrobkov c) chemikálií a chemických výrobkov"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Zmena navrhovanej činnosti spočíva v oddelení pôvodne posudzovanej lokality tak, že časť 1 sa touto zmenou úplne vypúšťa /Zóna 1 - po zmene zóna II - zmena bytovej výstavby na výstavbu rodinných domov nebude predmetom zmeny úz. rozhodnutia ale predmetom osobitného konania o zmene a doplnkoch územného plánu obce častá/ a pôvodná časť 2 sa mení a bude predmetom zmeny územného rozhodnutia pod názvom \"Nová štvrť Častá I\" pričom sa rozširuje o pozemky na ľavej strane pohľadovo od vstupu do lokality v počte 8 ks stavebných parciel, ktoré investor nadobudol dodatočne a zároveň niektoré pozemky na pravej strane sa delia z dôvodu efektívnejšieho využitia za súčasného dodržania regulatívov v územnom pláne obce Častá pre danú lokalitu.", "navrhovatel": {"name": "TK Develop s.r.o., Štúrova 71, 900 01  Modra", "ico": "36780537"}, "prislusnyOrgan": {"name": " Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Častá (okres: Pezinok)", "povolujuciOrgan": "Spoločný stavebný úrad, Mestský úrad Modra, Dukelská 38, 900 01  Modra.", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zmena navrhovanej činnosti", "number": 1, "items": [{"title": "Text oznámenia o zmene", "items": [{"type": "RTF", "label": "INFORMÁCIA o OZNÁMENÍ", "id": "218728", "url": "/eia/dokument/218728", "filesize": "11156", "date": "14.10. 2014"}, {"type": "PDF", "label": "Nová štvrť Častá I - prílohy", "id": "218727", "url": "/eia/dokument/218727", "filesize": "5576864", "date": "14.10. 2014"}, {"type": "PDF", "label": "Nová štvrť Častá I - text", "id": "218736", "url": "/eia/dokument/218736", "filesize": "2195422", "date": "14.10. 2014"}]}, {"title": "Vyjadrenie", "items": [{"type": "RTF", "label": "Vyjadrenie - Nová štvrť Častá I.", "id": "218982", "url": "/eia/dokument/218982", "filesize": "16308", "date": "20.10. 2014"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťovacie konanie", "link": "/eia/zistovacie-konanie", "children": []}, {"id": 7725, "parentId": 7722, "name": "Konanie o podnete", "link": "/eia/konanie-o-podnete", "children": []}, {"id": 7726, "parentId": 7722, "name": "Odborné stanovisko orgánu ochrany prírody a krajiny", "link": "/eia/odborne-stanovisko", "children": []}]}, {"id": 7727, "parentId": 7843, "name": "Ako prebieha EIA?", "link": "#", "children": [{"id": 7728, "parentId": 7727, "name": "Prehľad krokov", "link": "/eia/priebeh-procesu", "children": []}, {"id": 7729, "parentId": 7727, "name": "1. KROK – Informácia o navrhovanej činnosti alebo jej zmene", "link": "/eia/navrhovana-cinnost", "children": []}, {"id": 7730, "parentId": 7727, "name": "2. KROK – Rozsah hodno