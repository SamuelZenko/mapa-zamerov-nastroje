{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/logisticko-priemyselny-park-cierny-les", "@type": "EiaProject", "id": "159571", "seoId": "logisticko-priemyselny-park-cierny-les", "name": "Logisticko-priemyselný park Čierny les", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "7.7", "label": "Strojárska výroba, elektrotechnická výroba s výrobnou plochou"}, {"num": "9.16", "label": "Projekty rozvoja obcí vrátane a) pozemných stavieb alebo ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy b) statickej dopravy c) územných plánov zóny, ktoré nahrádzajú územné rozhodnutie pre cinnosti uvedené v písmenách a) a b)"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Vybudovanie logistického areálu a objektov občianskej vybavenosti. Logistický areál bude tvorený z jednotlivých hál (BCR1 a BCR2), ktoré budú slúžiť na skladovanie, ľahkú výrobu/montáž a na manipuláciu s tovarom v rozsahu nadväzujúcom na skladovanie tovaru. Vo dvojici objektov občianskej vybavenosti (BoxA a BoxB), sa budú nachádzať obchodno-výstavné priestory, v objektoch sa napája funkcia showroom-u, kancelárií a skladu.", "navrhovatel": {"name": "IMMOLEASE, spol. s.r.o.", "ico": "43842194"}, "prislusnyOrgan": {"name": " Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislava - Ružinov (okres: Bratislava II)", "povolujuciOrgan": "Miestny úrad MČ Bratislava – Ružinov\r\nOkresný úrad Bratislava", "schvalujuciOrgan": "Miestny úrad MČ Bratislava – RužinovOkresný úrad Bratislava", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "2. informácia pre verejnost 085897.pdf", "id": "309893", "url": "/eia/dokument/309893", "filesize": "236