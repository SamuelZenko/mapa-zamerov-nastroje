{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-borinka", "@type": "EiaProject", "id": "166208", "seoId": "uzemny-plan-obce-borinka", "name": "Územný plán obce Borinka", "zbierka": "24/2006 novela 372/2021 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 1"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Územnoplánovacia dokumentácia má za účel reflektovať doterajší vývoj obce Borinka, zmapovať požiadavky na nové riešenia a to premietnuť do návrhu funkčno – prevádzkového a hmotovo - priestorového riešenia obce. Hlavnou filozofiou je ochrana charakteristického obrazu obce v súlade s jej prírodným zázemím, so stabilizáciou a uvážlivým rozvojom funkcie bývania a príslušnej občianskej vybavenosti. Lokalizácia významnejších podnikateľských alebo výrobných prevádzok sa neuvažuje. Konkrétne úlohy a ciele riešenia sú definované v Zadaní pre vypracovanie ÚPN na základe výstupov z Prieskumov a rozborov a Prípravných prác.", "navrhovatel": {"name": "Obec Borinka, Obecný úrad Borinka, Dlhá 110, 900 32 Borinka ", "ico": "304689"}, "prislusnyOrgan": {"name": "Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Borinka (okres: Malacky)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo pri Obecnom úrade Borinka", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia k Územnému plánu obce Borinka.pdf", "id": "337360", "url": "/eia/dokument/337360", "filesize": "139602", "date": "03.01. 2022"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Borinka Oznamenie o SD 15dec2021 podpisane.pdf", "id": "337359", "url": "/eia/dokument/337359", "filesize": "734276", "date": "03.01. 2