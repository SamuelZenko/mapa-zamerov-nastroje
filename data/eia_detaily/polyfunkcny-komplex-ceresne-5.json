{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/polyfunkcny-komplex-ceresne-5", "@type": "EiaProject", "id": "167118", "seoId": "polyfunkcny-komplex-ceresne-5", "name": "Polyfunkčný komplex Čerešne 5", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.16", "label": "Projekty rozvoja obcí vrátane a) pozemných stavieb alebo ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy b) statickej dopravy c) územných plánov zóny, ktoré nahrádzajú územné rozhodnutie pre cinnosti uvedené v písmenách a) a b)"}], "proces": "Povinné hodnotenie", "cezhranicnaSpolupraca": null, "ucel": "Predmetom navrhovanej činnosti je vybudovanie nového polyfunkčného komplexu za účelom využitia riešeného územia s využitím jeho funkčného potenciálu v zmysle regulatívov územného plánu dotknutého sídla a s cieľom dotvárať už existujúcu, či súčasne realizovanú zástavbu predchádzajúcich etáp bytových domov s vplyvom na riešené územie.\r\nRealizáciou tejto navrhovanej činnosti by malo dôjsť podľa navrhovateľa k rozšíreniu ponuky priestorov pre bývanie v mestskej časti Bratislava – Dúbravka pre širšie vrstvy obyvateľstva a vytvoreniu atraktívneho a príjemného priestoru pre budúcich obyvateľov a návštevníkov spomínanej lokality.\r\n", "navrhovatel": {"name": "J&P, s.r.o., Šoltésovej 12, 811 08 Bratislava – Staré Mesto", "ico": "35841109"}, "prislusnyOrgan": {"name": " Ministerstvo životného prostredia SR", "address": "Námestie Ľ. Štúra 1, 81235 Bratislava"}, "dotknutaObec": "Bratislava - Dúbravka (okres: Bratislava IV)", "povolujuciOrgan": "Okresný úrad Bratislava, odbor starostlivosti o životné prostredie, Tomášikova 46, 832 05 Bratislava\r\nStavebný úrad mestskej časti Bratislava – Dúbravka. Žatevná 2, 844 02 Bratislava", "schvalujuciOrgan": "Okresný úrad Bratislava, odbor starostlivosti o životné prostredie, Tomášikova 46, 832 05 BratislavaStavebný úrad mestskej časti Bratislava – Dúbravka. Žatevná 2, 844 02 Bratislava ", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "informácia pre verejnosť.pdf", "id": "367435", "url": "/eia/dokument/367435", "filesize": "232640", "date": "19.09. 2022"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "EKOJET, s.r.o. Tehelná 19 831 03 Bratislava"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "prílohy.zip", "id": "351286", "url": "/eia/dokument/351286", "filesize": "9754271", "date": "19.09. 2022"}, {"type": "PDF", "label": "zámer navrhovanej činnosti.pdf", "id": "351271", "url": "/eia/dokument/351271", "filesize": "10038900", "date": "19.09. 2022"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia navrhovanej činnosti", "items": [{"type": "PDF", "label": "rozsah hodnotenia.pdf", "id": "357974", "url": "/eia/dokument/357974", "filesize": "813140", "date": "21.12. 2022"}]}]}, {"step": "Správa o hodnotení", "number": 3, "items": [{"title": "Informácia    o správe o hodnotení", "items": [{"type": "PDF", "label": "informácia pre verejnosť.pdf", "id": "367437", "url": "/eia/dokument/367437", "filesize": "209546", "date": "28.07. 2023"}]}, {"type": "text", "label": "Spracovateľ správy o hodnotení", "value": ""}, {"title": "Text správy o hodnotení", "items": [{"type": "ZIP", "label": "prílohy.zip", "id": "367433", "url": "/eia/dokument/367433", "filesize": "41809347", "date": "28.07. 2023"}, {"type": "PDF", "label": "správa o hodnotení navrhovanej činnosti.pdf", "id": "367432", "url": "/eia/dokument/367432", "filesize": "7106200", "date": "28.07. 2023"}]}]}, {"step": "Verejné prerokovanie", "number": 4, "items": [{"type": "text", "label": "Verejné prerokovanie", "value": "Verejné prerokovanie sa uskutoční 07.09.2023 (štvrtok) o 10:00 na Magistráte hlavného mesta Slovenskej republiky Bratislavy v zasad