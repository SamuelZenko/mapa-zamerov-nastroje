{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-zohor-zmeny-doplnky-c-7", "@type": "EiaProject", "id": "152811", "seoId": "uzemny-plan-obce-zohor-zmeny-doplnky-c-7", "name": "Územný plán obce Zohor – Zmeny a doplnky č. 7", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Navrhovaný strategický dokument predstavuje zmenu využívania plochy využívanej ako orná pôda a trvalé trávne porasty na stavebné účely o výmere 5,3300 ha pre novú lokalitu č. B25, t. j. v prípade realizácie navrhovaných činností by došlo k novému použitiu poľnohospodárskej pôdy na stavebné účely a iné nepoľnohospodárske účely. Zároveň obec ponúka ako kompenzáciu za nový záber poľnohospodárskej pôdy pre lokalitu č. B25 vrátenie poľnohospodárskej pôdy odsúhlasenej na odňatie pre lokalitu č. A1 (teraz č. K6) v celkovej výmere 5,3300 ha, takže konečný záber poľnohospodárskej pôdy bude nulový.", "navrhovatel": {"name": "Obec Zohor, Obecný úrad Zohor, Nám. 1. mája 1, 900 51 Zohor", "ico": "508381"}, "prislusnyOrgan": {"name": "Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Zohor (okres: Malacky)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo pri Obecnom úrade Zohor", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia Zmeny a doplnky c. 7 Zohor.pdf", "id": "295448", "url": "/eia/dokument/295448", "filesize": "203261", "date": "14.08. 2019"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Zohor ZaD 7 Oznámenie o strateg dokumente.pdf", "id": "295438", "url": "/eia/dokument/295438", "filesize": "76826