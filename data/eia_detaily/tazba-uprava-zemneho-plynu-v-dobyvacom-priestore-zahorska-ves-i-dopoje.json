{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/tazba-uprava-zemneho-plynu-v-dobyvacom-priestore-zahorska-ves-i-dopoje", "@type": "EiaProject", "id": "159151", "seoId": "tazba-uprava-zemneho-plynu-v-dobyvacom-priestore-zahorska-ves-i-dopoje", "name": "Ťažba a úprava zemného plynu v dobývacom priestore Záhorská Ves I. – dopojenie vrtu Záhorská Ves 6", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "1.16", "label": "Vrty (okrem vrtov na skúmanie stability pôdy súvisiacich s tažobnou cinnostou) najmä: vrty na využívanie geotermálnej energie a geotermálnych vôd; vrty na uskladnenie rádioaktívneho odpadu; vrty pre vodné zdroje"}, {"num": "1.5", "label": "Tažba a úprava zemného plynu"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Predmetom zmeny navrhovanej činnosti je pripojenie ďalšieho ťažobného vrtu Záhorská Ves 6 (ďalej len „ZV6) na ťažbu zemného plynu v DP Záhorská Ves I, s jeho úpravou v existujúcom Zbernom plynovom stredisku Záhorská Ves, ktoré sa nachádza mimo DP Záhorská Ves I. Ďalej ide o: \r\n- overenie objemovo vypočítaných zásob zemného plynu a spresnenie ich vyťažiteľného množstva, \r\n- overenie ložiskového režimu otvoreného obzoru vo vrte ZV6, spresnenie poznatkov o prítomnosti ložiskovej vody a vplyv zmeny ťažobného režimu na jej množstvo v ťaženom médiu, \r\n- získanie nových údajov pre vedenie ďalšieho geologického prieskumu na účely banskej činnosti – dobývania horľavého zemného plynu, \r\nŤažba bude vykonávaná cez existujúcu technológiu zberu (spoločnú VVTL prípojku vrtov ZV5 a ZV6) a úpravy zemného plynu ZPS ZV. \r\nPosudzovaná činnosť predstavuje v zmysle zákona č. 24/2006 Z. z. v dotknutom prostredí jestvujúcu činnosť. \r\n", "navrhovatel": {"name": "NAFTA a.s., Votrubova 1, 821 09 Bratislava", "ico": "36286192"}, "prislusnyOrgan": {"name": " Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Záhorská Ves (okres: Malacky)", "povolujuciOrgan": "1.\tObec Záhorská Ves, Obecný úrad Záhorská Ves, Hlavná ul. 29, 900 65 Záhorská Ves\r\n2.\tObvodný banský úrad, Mierová 19, 821 05 Bratislava\r\n", "schvalujuciOrgan": "1.\tObec Záhorská Ves, Obecný úrad Záhorská Ves, Hlavná ul. 29, 900 65 Záhorská Ves2.\tObvodný banský úrad, Mierová 19, 821 05 Bratislava", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zmena navrhovanej činnosti", "number": 1, "items": [{"title": "Informácia pre verejnosť", "items": [{"type": "PDF", "label": "Informácia pre verejnost Tažba a úprava zemného plynu v dobývacom priestore Záho.pdf", "id": "308913", "url": "/eia/dokument/308913", "filesize": "235470", "date": "27.05. 2020"}]}, {"title": "Text oznámenia o zmene", "items": [{"type": "PDF", "label": "Príloha č_3.pdf", "id": "308916", "url": "/eia/dokument/308916", "filesize": "547807", "date": "27.05. 2020"}, {"type": "PDF", "label": "Príloha č_2.pdf", "id": "308917", "url": "/eia/dokument/308917", "filesize": "490259", "date": "27.05. 2020"}, {"type": "PDF", "label": "Príloha č_1.pdf", "id": "308918", "url": "/eia/dokument/308918", "filesize": "492053", "date": "27.05. 2020"}, {"type": "PDF", "label": "Oznámenie o zmene navrhovanej činnosti.pdf", "id": "308919", "url": "/eia/dokument/308919", "filesize": "2873689", "date": "27.05. 2020"}, {"type": "PDF", "label": "Príloha č_5.pdf", "id": "308914", "url": "/eia/dokument/308914", "filesize": "615418", "date": "27.05. 2020"}, {"type": "PDF", "label": "Príloha č_4.pdf", "id": "308915", "url": "/eia/dokument/308915", "filesize": "313892", "date": "27.05. 2020"}]}, {"title": "Rozhodnutie pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "Rozhodnutie zo zistovacieho konania zverejnené dna 20.07.2020.pdf", "id": "311521", "url": "/eia/dokument/311521", "filesize": "650839", "date": "20.07. 2020"}]}, {"title": "Právoplatné rozhodnutie", "items": [{"type": "PDF", "label": "Rozhodnutie zo zisťovacieho konania právoplatné odo dňa 27.08.2020.pdf", "id": "313423", "url": "/eia/dokument/313423", "filesize": "3707962", "date": "02.09. 2020"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťovacie konanie", "link": "/eia/zistovacie-konanie", "children": []}, {"id": 7725, "parentId": 7722, "name": "Konanie o podnete", "link": "/eia/konanie-o-podnete", "children": []}, {"id": 7726, "parentId": 7722, "name": "Odborné stanovisko orgánu ochrany prírody a krajiny", "link": "/eia/odborne-stanovisko", "children": []}]}, {"id": 7727, "parentId": 7843, "name": "Ako prebieha EIA?", "link": "#", "children": [{"id": 7728, "parentId": 7727, "name": "Prehľad krokov", "link": "/eia/priebeh-procesu", "children": []}, {"id": 7729, "parentId": 7727, "name": "1. KROK – Informácia o navrhovanej činnosti alebo jej zmene", "link": "/eia/navrhovana-cinnost", "children": []}, {"id": 7730, "parentId": 7727, "name": "2. KROK – Rozsah hodnotenia a harmonogram", "link": "/eia/rozsah-hodnotenia", "children": []}, {"id": 7731, "parentId": 7727, "name": "3. KROK – Správa o hodnotení a jej pripomienkovanie", "link": "/eia/sprava-o-hodnoteni", "children": []}, {"id": 7732, "parentId": 7727, "name": "4. KROK – Verejné prerokovanie správy