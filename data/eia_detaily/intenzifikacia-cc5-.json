{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/intenzifikacia-cc5-", "@type": "EiaProject", "id": "165461", "seoId": "intenzifikacia-cc5-", "name": "Intenzifikácia CC5 ", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "4.2", "label": "Rafinérie ropy, minerálnych olejov a plynu (okrem zariadení na výrobu mazív z ropy)"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Spoločnosť SLOVNAFT, a. s. realizuje výstavbu Etylénového zásobníka (EST) s čím súvisí potreba zvýšenia kapacity CC5 (cirkulačné centrum chladiacej vody). Predmetom zmeny navrhovanej činnosti je zvýšenie kapacity CC5 o 1600 m3/h cirkulačnej vody, pri zachovaní chladiaceho pásma (delta)t=10°C. Nové chladiace veže budú inštalované na oceľovej plošine a určenej ploche v uzavretom areáli rafinérie SLOVNAFT, a. s. na bloku 71.\r\n\r\n", "navrhovatel": {"name": "SLOVNAFT, a. s.,Vlčie hrdlo 1, 824 12 Bratislava", "ico": "31322832"}, "prislusnyOrgan": {"name": " Ministerstvo životného prostredia SR", "address": "Námestie Ľ. Štúra 1, 81235 Bratislava"}, "dotknutaObec": "Bratislava - Ružinov (okres: Bratislava II)", "povolujuciOrgan": "Miestny úrad mestskej časti Bratislava-Ružinov, Stavebný úrad, Mierová 21, 827 05 Bratislava 2, \r\nOkresný úrad Bratislava, Odbor starostlivosti o životné prostredie, Štátna vodná správa, Tomášikova 46, 832 05 Bratislava", "schvalujuciOrgan": "Slovenská inšpekcia životného prostredia, Inšpektorát životného prostredia  Bratislava, Odbor integrovaného povoľovania a kontroly, Jeséniova 17, 831 01  Bratislava", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zmena navrhovanej činnosti", "number": 1, "items": [{"title": "Informácia pre verejnosť", "items": [{"type": "PDF", "label": "Informácia pre verejnosť_SLOVNAFT, a. s. _Intenzifikácia CC5.pdf", "id": "326468", "url": "/eia/dokument/326468", "filesize": "31296