{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/obytne-subory-viedenska-cesta-zapad-1", "@type": "EiaProject", "id": "170237", "seoId": "obytne-subory-viedenska-cesta-zapad-1", "name": "Obytné súbory Viedenská cesta - západ", "zbierka": "24/2006 novela 350/2024 Z.z. časť EIA", "stav": "Zámer", "cinnosti": [{"num": "13.1", "label": "Projekty rozvoja obcí vrátane:  a) prípravy územia na následnú výstavbu pozemných stavieb od 10 000 m2 záberu plochy vrátane; b) pozemných stavieb a ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy od 10 000 m2 hrubej podlažnej plochy nadzemných podlaží v zastavanom území vrátane a od 1 000 m2 hrubej podlažnej plochy nadzemných podlaží mimo zastavaného územia vrátane"}, {"num": "13.2", "label": "Parkovacie plochy od 200 parkovacích stojísk pre motorové vozidlá vrátane"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovaného zámeru je výstavba obytnej zóny na zastaviteľnom území o výmere 21 641 m2, vrátane potrebnej technickej infraštruktúry, dopravnej vybavenosti a úpravy krajiny. Navrhovaná činnosť je koncipovaná ako zástavba 3 samostatných polouzatvorených mestských blokov tvoriacich okrajovú líniu plôch neurbanizovaného prírodného prostredia pozdĺž komunikácie Viedenská cesta.", "navrhovatel": {"name": "YIT Slovakia a.s., Svätoplukova II. 18892/2 A, 821 08 Bratislava", "ico": "35718625"}, "prislusnyOrgan": {"name": " Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislava - Petržalka (okres: Bratislava V)", "povolujuciOrgan": "Okresný úrad Bratislava, odbor starostlivosti o životné prostredie,\r\nMČ Bratislava - Petržalka", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Infor