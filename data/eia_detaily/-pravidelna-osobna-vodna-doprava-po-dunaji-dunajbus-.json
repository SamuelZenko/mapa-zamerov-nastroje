{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/-pravidelna-osobna-vodna-doprava-po-dunaji-dunajbus-", "@type": "EiaProject", "id": "147189", "seoId": "-pravidelna-osobna-vodna-doprava-po-dunaji-dunajbus-", "name": "„Pravidelná osobná vodná doprava po Dunaji - DUNAJBUS“", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "13.11", "label": "Vnútrozemské vodné cesty a prístavy vrátane prístavných zariadení pre vnútrozemskú vodnú dopravu"}, {"num": "9.16", "label": "Projekty rozvoja obcí vrátane a) pozemných stavieb alebo ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy b) statickej dopravy c) územných plánov zóny, ktoré nahrádzajú územné rozhodnutie pre cinnosti uvedené v písmenách a) a b)"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovanej činnosti je na cca 50 km trase Dunaja zriadiť osobnú vodnú kyvadlovú dopravu medzi MČ Bratislava  - Devín a obcou Vojka nad Dunajom vybudovaním nových plávajúcich prístavísk (slúžiacich ako zastávky s prístreškom a časť ako zastávky s občerstvením), ktoré budú začlenené k existujúcim prístaviskám, čím vznikne na Dunaji 8 zastávok pre lode. Plynulosť premávky osobnej vodnej dopravy bude zabezpečovať 7 plavidiel typu katamarán s výtlakom lode 40 t bez zaťaženia a 50 t pri úplnom zaťažení. Neďaleko od prístaviska v Hamuliakove bude zriadene DEPO/zimný prístav. V rámci navrhovanej činnosti dôjde aj k rozšíreniu pôvodného parkoviska a výstavbe nového parkoviska. ", "navrhovatel": {"name": "Pro-Danubia – Združenie obcí pre miestnu dopravu po Dunaji, Dunajská 127/18, 900 43 Hamuliakovo", "ico": "42447933"}, "prislusnyOrgan": {"name": " Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Trnavský Kraj, Bratislavský Kraj ", "povolujuciOrgan": "Okresný úrad Bratislava, odbor starostlivosti o životné prostredie; Okresný úrad Senec, odbor starostlivosti o životné prostredie; Okresný úrad Dunajská Streda, odbor starostlivosti o životné prostredie; Stavebný úrad obce Hamuliakovo; Stavebný úrad mesta Šamorín\r\n", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "info-pre-verejnost-DUNAJBUS-rtf.pdf", "id": "285238", "url": "/eia/dokument/285238", "filesize": "228480", "date": "02.01. 2019"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "EKOJET, s.r.o., Staré Grunty 9A, 841 04 Bratislava"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "D_mapa_2b_NATURA2000.pdf.pdf", "id": "285230", "url": "/eia/dokument/285230", "filesize": "1215713", "date": "02.01. 2019"}, {"type": "PDF", "label": "J_Rozptylová štúdia_Dunajbus.pdf", "id": "285236", "url": "/eia/dokument/285236", "filesize": "175276", "date": "02.01. 2019"}, {"type": "PDF", "label": "I_Akustická štúdia_Dunajbus.pdf", "id": "285235", "url": "/eia/dokument/285235", "filesize": "4305281", "date": "02.01. 2019"}, {"type": "PDF", "label": "A_Zámer EIA_Dunajbus.pdf", "id": "285227", "url": "/eia/dokument/285227", "filesize": "17948617", "date": "02.01. 2019"}, {"type": "PDF", "label": "B_mapa_1_Umiestnenie navrhovanej činnosti.pdf.pdf", "id": "285228", "url": "/eia/dokument/285228", "filesize": "4607531", "date": "02.01. 2019"}, {"type": "PDF", "label": "C_mapa_2a_Veľkoplošné a Maloplošné CHU.pdf.pdf", "id": "285229", "url": "/eia/dokument/285229", "filesize": "5593413", "date": "02.01. 2019"}, {"type": "PDF", "label": "rozhodnutie.pdf", "id": "285237", "url": "/eia/dokument/285237", "filesize": "631981", "date": "02.01. 2019"}, {"type": "PDF", "label": "E_mapa_3a_parkovisko Hamuliakovo_variant č.1.pdf.pdf", "id": "285231", "url": "/eia/dokument/285231", "filesize": "240844", "date": "02.01. 2019"}, {"type": "PDF",