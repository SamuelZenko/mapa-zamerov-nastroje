{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/roboticka-farma-senkvice", "@type": "EiaProject", "id": "149790", "seoId": "roboticka-farma-senkvice", "name": "Robotická farma Šenkvice", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "11.1", "label": "Zariadenia na intenzívnu živocíšnu výrobu vrátane depónií vedlajších produktov s kapacitou a) hospodárskych zvierat b) ošípaných c) hydiny"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Predmetom navrhovanej činnosti je modernizácia existujúcej poľnohospodárskej farmy. Jedná sa o výstavbu novej robotickej stajne s mliečnicou a nevyhnutným technologickým a sociálnym zázemím, nové reprodukčné stajne, doplnenie skladovacích kapacít na vyprodukovaný tekutý hnoj a doplnenie skladovacích kapacít na siláž. Stavba bude ďalej doplnená o potrebné inžinierske prípojky. Súčasný systém chovu dojníc v 6 stajniach a s dojením na existujúcej dojárne bude nahradený novým progresívnym spôsobom chovu s robotickým dojením priamo v produkčnej stajni.", "navrhovatel": {"name": "Poľnohospodárske družstvo v Šenkviciach, 900 81 Šenkvice", "ico": "00190705"}, "prislusnyOrgan": {"name": " Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Šenkvice (okres: Pezinok)", "povolujuciOrgan": "stavebný úrad Šenkvice", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "PD Šenkvice_info pre verejnost.pdf", "id": "289716", "url": "/eia/dokument/289716", "filesize": "220930", "date": "24.04. 2019"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "IGES s.r.o., Komenského 29, 902 01 Pezinok"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "zámer EIA Še