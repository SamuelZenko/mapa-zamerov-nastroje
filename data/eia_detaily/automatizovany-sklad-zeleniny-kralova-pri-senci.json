{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/automatizovany-sklad-zeleniny-kralova-pri-senci", "@type": "EiaProject", "id": "169923", "seoId": "automatizovany-sklad-zeleniny-kralova-pri-senci", "name": "Automatizovaný sklad zeleniny, Kráľová pri Senci", "zbierka": "24/2006 novela 350/2024 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "13.1", "label": "Projekty rozvoja obcí vrátane:  a) prípravy územia na následnú výstavbu pozemných stavieb od 10 000 m2 záberu plochy vrátane; b) pozemných stavieb a ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy od 10 000 m2 hrubej podlažnej plochy nadzemných podlaží v zastavanom území vrátane a od 1 000 m2 hrubej podlažnej plochy nadzemných podlaží mimo zastavaného územia vrátane"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovanej činnosti je rozšírenie stávajúceho areálu o výstavbu automatizovaného skladu zeleniny s predpokladanou uskladňovacou kapacitou max.2814 ton zeleniny, a s predpokladaným výkonom úpravy suroviny 140 ton/deň. Súčasťou navrhovanej stavby bude riešenie skladových regálov pre uskladnenie zeleniny, triediaca a kalibračná linka, nové prípojky inžinierskych sietí ako i riešenie zachytávania dažďových vôd z areálu. ", "navrhovatel": {"name": "MAČAJ a.s., Kráľová pri Senci 455, 900 50 Kráľová pri Senci", "ico": "55032648"}, "prislusnyOrgan": {"name": " Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Kostolná pri Dunaji (okres: Senec)", "povolujuciOrgan": "Okresný úrad Senec, Obec Kostolná pri Dunaji", "schvalujuciOrgan": "Okresný úrad Senec, Obec Kostolná pri Dunaji", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Informácia pre verejnosť-Mačaj a.s., Kráľová pri Senci.pdf", "id": "387775", "url": "/eia/dokument/387775", "filesize": "123818", "date": "22.01. 2025"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "EnvIdeal s.r.o., Jaskový rad 151, 831 01 Bratislava, RNDr.Ľuboš Haltmar"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "Z_EIA_Automatizovany sklad zeleniny_komplet_WEB.pdf", "id": "387774", "url": "/eia/dokument/387774", "filesize": "9902956", "date": "22.01. 2025"}, {"type": "PDF", "label": "Doplnujuce informacie-MAČAJ a.s..pdf", "id": "390120", "url": "/eia/dokument/390120", "filesize": "303733", "date": "26.03. 2025"}]}, {"title": "Záväzné stanovisko zo ZK pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "Záväzné stanovisko zo zisťovacieho konania.pdf", "id": "390633", "url": "/eia/dokument/390633", "filesize": "436444", "date": "14.04. 2025"}]}, {"title": "Pravoplatné záväzné stanovisko zo zisťovacieho konania", "items": [{"type": "PDF", "label": "0028449_2025 Právoplatné záv.stanovisko-MAČAJ a.s..pdf", "id": "391515", "url": "/eia/dokument/391515", "filesize": "488913", "date": "07.05. 2025"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťovacie konanie", "link": "/eia/zistovacie-konanie", "children": []}, {"id": 7725, "parentId": 7722, "name": "Konanie o podnete", "li