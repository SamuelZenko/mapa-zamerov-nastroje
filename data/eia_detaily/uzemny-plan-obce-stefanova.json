{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-stefanova", "@type": "EiaProject", "id": "153811", "seoId": "uzemny-plan-obce-stefanova", "name": "ÚZEMNÝ PLÁN OBCE ŠTEFANOVÁ", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 1"}], "proces": "Povinné hodnotenie", "cezhranicnaSpolupraca": null, "ucel": "Cieľom pripravovaného Územného plánu obce Štefanová bude v zmysle ustanovení § 1 zákona č.50/1976 Zb. v znení neskorších predpisov komplexné riešenie priestorového usporiadania a funkčného využitia územia v rozsahu katastrálneho územia obce, stanovenie zásad jeho organizácie a vecná a časová koordinácia činností v území. Návrhové obdobie územnoplánovacej dokumentácie stanovujeme do roku 2035.", "navrhovatel": {"name": "Obec Štefanová, Obecný úrad, 900 86 Štefanová č. 100", "ico": "00305111"}, "prislusnyOrgan": {"name": "Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Doľany, Častá, Budmerice, Štefanová, Borová (okresy: Pezinok, Trnava)", "povolujuciOrgan": null, "schvalujuciOrgan": "obecné zastupiteľstvo Obce Štefanová", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "UPD Štefanová_informácia pre verejnost.pdf", "id": "297254", "url": "/eia/dokument/297254", "filesize": "195338", "date": "23.09. 2019"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "oznamenie_sea_stefanova.pdf", "id": "297272", "url": "/eia/dokument/297272", "filesize": "150078", "date": "23.09. 2019"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia", "items": [{"type": "PDF", "label": "1_UPN Štefanová_rozsah hodnotenia.pdf", "id": "303727", "url": "/eia/doku