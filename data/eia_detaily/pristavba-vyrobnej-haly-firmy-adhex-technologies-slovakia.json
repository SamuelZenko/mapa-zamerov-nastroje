{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/pristavba-vyrobnej-haly-firmy-adhex-technologies-slovakia", "@type": "EiaProject", "id": "170462", "seoId": "pristavba-vyrobnej-haly-firmy-adhex-technologies-slovakia", "name": "Prístavba výrobnej haly firmy Adhex Technologies Slovakia", "zbierka": "24/2006 novela 350/2024 Z.z. časť EIA", "stav": "Oznámenie o zmene", "cinnosti": [{"num": "13.1", "label": "Projekty rozvoja obcí vrátane:  a) prípravy územia na následnú výstavbu pozemných stavieb od 10 000 m2 záberu plochy vrátane; b) pozemných stavieb a ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy od 10 000 m2 hrubej podlažnej plochy nadzemných podlaží v zastavanom území vrátane a od 1 000 m2 hrubej podlažnej plochy nadzemných podlaží mimo zastavaného územia vrátane"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Spoločnosť sa zaoberá výrobou samolepiacich materiálov, výrobkov z plastov, súčiastok a\r\nkomponentov pre automobilový piemysel,,taktiež výrobou zdravotníckych pomôcok. Spoločnosť\r\noperuje procesmi termoformovania, nanášania lepidla (coating), vysekávania a flexographiou.\r\nZmenou navrhovanej činnosti dôjde k rozšíreniu výroby a skladovacích priestorou.\r\nZmena navrhovanej činnosti bude realizovaná mimo zastavaného územia mesta Senec. Na\r\npozemku, ktorý je určený pre prístavbu, sa nenachádzajú žiadne objekty.\r\n", "navrhovatel": {"name": "Adhex Technologies Slovakia s.r.o., Poľná 9, 903 01 Senec", "ico": "35961325"}, "prislusnyOrgan": {"name": " Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Senec (okres: Senec)", "povolujuciOrgan": "Okresný úrad Senec, OSŽP\r\nMesto Senec", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zmena navrhovanej činnosti", "number": 1, "items": [{"title": "Informácia pre verejnosť", "it