{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/-uzemny-plan-obce-marianka-zmeny-doplnky-c-3-", "@type": "EiaProject", "id": "169499", "seoId": "-uzemny-plan-obce-marianka-zmeny-doplnky-c-3-", "name": "„Územný plán obce Marianka – Zmeny a doplnky č. 3“", "zbierka": "24/2006 novela 372/2021 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Hlavným cieľom zmien v strategickom dokumente je zabezpečiť územnícke podmienky \r\npre realizáciu zámerov obce, investorov, občanov za predpokladu dosiahnutia \r\noptimálnych urbanistických a environmentálnych väzieb a súladu s podmienkami trvalo \r\nudržateľného života. \r\n Predmetom ZaD č.3 ÚPN obce Marianka je v zmysle prijatého uznesenia obecného \r\nzastupiteľstva riešenie požiadavky na úpravu a doplnenie zásad funkčnej a priestorovej regulácie územia a doplnenie plôch pre umiestnenie verejnoprospešných stavieb, uvádzané v časti D. Záväzná časť Územného plánu obce Marianka. \r\n Návrh zmeny funkčného využitia územia a návrh rozšírenia plôch pre novú výstavbu nie sú predmetom riešenia ZaD č.3. \r\n", "navrhovatel": {"name": "Obec Marianka, Obecný úrad, Školská 32, 900 33 Marianka", "ico": "00304930"}, "prislusnyOrgan": {"name": "Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Borinka, Bratislava - Záhorská Bystrica, Stupava, Marianka (okresy: Malacky, Bratislava IV)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo Obce Marianka", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia k Územnému plánu obce Marianka, ZaD č.3.pdf", "id": "382781", "url": "/eia/dokument/382781", "filesize": "106869", "date": "16.08. 2024"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Oznámenie o SD_ZaD č3_ÚPN Marianka.pdf", "id": "382780", "url": "/eia/dokument/382780", "filesize": "154627", "date": "16.08. 2024"}]}, {"title": "Rozhodnutie zo zisťovacieho konania", "items": [{"type": "PDF", "label": "Rozhodnutie zo zisťovacieho konania.pdf", "id": "384399", "url": "/eia/dokument/384399", "filesize": "336422", "date": "01.10. 2024"}]}, {"title": "Text strategického dokumentu", "items": [{"type": "PDF", "label": "1_Širšie vzťahy.pdf", "id": "382782", "url": "/eia/dokument/382782", "filesize": "3798684", "date": "16.08. 2024"}, {"type": "PDF", "label": "10-ZD3_Schéma ZČ.pdf", "id": "382783", "url": "/eia/dokument/382783", "filesize": "953275", "date": "16.08. 2024"}, {"type": "PDF", "label": "ZD 3_Marianka_Textová časť.pdf", "id": "382784", "url": "/eia/dokument/382784", "filesize": "359794", "date": "16.08. 2024"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťovacie konanie", "link": "/eia/zistovacie-konanie", "children": []}, {"id": 7725, "parentId": 7722, "name": "Konanie o podnete", "link": "/eia/konanie-o-podnete", "children": []}, {"id": 7726, "parentId": 7722, "name": "Odborné stanovisko orgánu ochrany prírody a krajiny", "link": "/eia/odborne-stanovisko", "children