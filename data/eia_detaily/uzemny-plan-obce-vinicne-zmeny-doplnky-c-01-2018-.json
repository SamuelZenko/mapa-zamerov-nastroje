{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-obce-vinicne-zmeny-doplnky-c-01-2018-", "@type": "EiaProject", "id": "143389", "seoId": "uzemny-plan-obce-vinicne-zmeny-doplnky-c-01-2018-", "name": "Územný plán obce Viničné – Zmeny a doplnky č. 01/2018 ", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Riešeným územím „Zmien a doplnkov č. 01/2014“ sú lokality (regulačné bloky) č. B3/r-01/2018, B4/r-01/2018, F/r-01/2014-01/2018, K/r-01/2014-01/2018, OH1/r-01/2018, PP1.1/r-01/2018, PP1.2/r-01/2018, L2-Z2/r-01/2018, ako aj zmeny a doplnky bez ďalšieho označenia (podrobnejšie pozri „Cieľ riešenia“ v ďalšom texte), nachádzajúce sa v k. ú. Viničné.\r\nHlavným dôvodom obstarania „Zmien a doplnkov č. 01/2018“ je záujem obce Viničné, ako orgánu územného plánovania, vytvoriť na základe nových poznatkov vhodnú ÚPD pre usmerňovanie investičnej činnosti na území obce Viničné. \r\n", "navrhovatel": {"name": "Obec Viničné, Obecný úrad, Cintorínska 13, 900 23 Viničné", "ico": "00508306"}, "prislusnyOrgan": {"name": "Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Pezinok, Viničné, Šenkvice, Slovenský Grob (okres: Pezinok)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo obce Viničné", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "ZaD Vinicné 1_2018_informácia o oznámení.pdf", "id": "277617", "url": "/eia/dokument/277617", "filesize": "204304", "date": "27.06. 2018"}]}, {"title": "Oznámenie", "items": [{"type": "JPG", "label": "Vinicne ZaD 01 2018 Vykres 1.jpg", "id": "277609", "url": "/eia/dokument/277