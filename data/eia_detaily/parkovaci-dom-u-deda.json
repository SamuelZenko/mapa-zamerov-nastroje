{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/parkovaci-dom-u-deda", "@type": "EiaProject", "id": "168056", "seoId": "parkovaci-dom-u-deda", "name": "Parkovací dom u Deda", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Zámer", "cinnosti": [{"num": "9.16", "label": "Projekty rozvoja obcí vrátane a) pozemných stavieb alebo ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy b) statickej dopravy c) územných plánov zóny, ktoré nahrádzajú územné rozhodnutie pre cinnosti uvedené v písmenách a) a b)"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovanej činnosti je zlepšenie podmienok parkovania v MČ Bratislava – Ružinov. Uvažuje sa pozemok zastavať jedným samostatne stojacim objektom občianskej vybavenosti – Parkovacím domom. Objekt  parkovacieho domu je trojpodlažný, z čoho jedno podlažie je v suteréne a dve podlažia sú nadzemné, pričom polovice pôdorysných plôch nadzemných podlaží sú prevýšené. V parkovacom dome sa navrhuje 118 parkovacích miest. ", "navrhovatel": {"name": "Mestská časť Bratislava-Ružinov", "ico": "00603155 "}, "prislusnyOrgan": {"name": " Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislava - Ružinov (okres: Bratislava II)", "povolujuciOrgan": "MČ Bratislava Ružinov - stavebný úrad, OUBA  ", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Informácia pre verejnosť.pdf", "id": "365539", "url": "/eia/dokument/365539", "filesize": "238230", "date": "22.06. 2023"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "ENVIRO SYSTEM, spol. s.r.o., Košická 37, 821 09 Bratislava, IČO: 35 901 284"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "Zámer -Parkovací dom u Deda.pdf", "id": "365542", "url": "/eia/dokument/365542", "filesize": "1916191", "date": "22.06. 2023"}, {"type": "PDF", "label": "Príloha_1 - Upustenie od požiadavky variantného riešenia.pdf", "id": "365519", "url": "/eia/dokument/365519", "filesize": "84932", "date": "22.06. 2023"}, {"type": "PDF", "label": "Príloha_2 - Koordinačná situácia.pdf", "id": "365520", "url": "/eia/dokument/365520", "filesize": "867019", "date": "22.06. 2023"}, {"type": "PDF", "label": "Príloha_7 - Akustická štúdia.pdf", "id": "365523", "url": "/eia/dokument/365523", "filesize": "2865861", "date": "22.06. 2023"}, {"type": "PDF", "label": "Príloha_5 - POHĽADY.pdf", "id": "365522", "url": "/eia/dokument/365522", "filesize": "570084", "date": "22.06. 2023"}, {"type": "PDF", "label": "Príloha_6 - Fotodokumentácia NČ.pdf", "id": "365544", "url": "/eia/dokument/365544", "filesize": "721493", "date": "22.06. 2023"}, {"type": "PDF", "label": "Príloha_4 - Situácia dopravného riešenia.pdf", "id": "365543", "url": "/eia/dokument/365543", "filesize": "1381946", "date": "22.06. 2023"}, {"type": "PDF", "label": "Príloha_3 - Situácia zelene, plôch a výrubu stromov.pdf", "id": "365521", "url": "/eia/dokument/365521", "filesize": "1387159", "date": "22.06. 2023"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťova