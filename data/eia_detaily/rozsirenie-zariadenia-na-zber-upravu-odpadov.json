{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/rozsirenie-zariadenia-na-zber-upravu-odpadov", "@type": "EiaProject", "id": "163071", "seoId": "rozsirenie-zariadenia-na-zber-upravu-odpadov", "name": "Rozšírenie zariadenia na zber a úpravu odpadov", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.10", "label": "Zhromaždovanie odpadov zo železných kovov, z neželezných kovov alebo starých vozidiel"}, {"num": "9.9", "label": "Stavby, zariadenia, objekty a priestory na nakladanie s nebezpecnými odpadmi"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Prevádzkované zariadenie má schválené prevádzkové dokumenty pre nakladanie s odpadmi v súlade s požiadavkami príslušných orgánov a organizácii štátnej správy.\r\nNavrhovaná zmena nepredstavuje zásah do jestvujúcich priestorov a nejedná sa o novú investičnú výstavbu a činnosť sa v uvedenom areáli v súčasnosti vykonáva.\r\nPotreba zabezpečenia zberu odpadov, zabezpečenie správneho nakladania s vytriedenými druhmi odpadu od ich zhromažďovania, triedenia a prepravy za účelom ich využitia alebo zodpovedajúceho zneškodnenia je jednou zo základných požiadaviek koncepcie odpadového hospodárstva regiónu\r\nÚčelom oznámenia zmeny navrhovanej činnosti je rozšírenie činnosti spoločnosti o ďalšie druhy odpadov v zmysle platnej legislatívy na úseku odpadového hospodárstva a zvýšenie kapacity zariadenia.Predmetom činnosti v riešenom zariadení je zber, výkup, skladovanie, triedenie, úprava (drvenie, rezanie) resp. následné odovzdanie odpadov na ďalšie zhodnotenie.", "navrhovatel": {"name": "Ferowim, s.r.o. ", "ico": "50381181"}, "prislusnyOrgan": {"name": " Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Tomášov (okres: Senec)", "povolujuciOrgan": "Okresný úrad Senec, Obec Tomášov", "schvalujuciOrgan": "Okresný úrad Senec, Obec Tomášov", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zmena navrhovanej činnosti", "number": 1, "items": [{"title": "Informácia pre verejnosť", "items": [{"type": "PDF", "label": "Informácia pre verejnosť.pdf", "id": "321858", "url": "/eia/dokument/321858", "filesize": "239266", "date": "04.03. 2021"}, {"type": "PDF", "label": "Doplňujúce informácie 1.časť.pdf", "id": "325055", "url": "/eia/dokument/325055", "filesize": "648108", "date": "30.03. 2021"}, {"type": "PDF", "label": "Doplňujúce ifnormácei 2.časť.pdf", "id": "325087", "url": "/eia/dokument/325087", "filesize": "4969288", "date": "30.03. 2021"}]}, {"title": "Text oznámenia o zmene", "items": [{"type": "PDF", "label": "Obsah oznámenia o zmene.pdf", "id": "325060", "url": "/eia/dokument/325060", "filesize": "464235", "date": "10.12. 2020"}, {"type": "PDF", "label": "Parcela registra C, 365_1.pdf", "id": "318313", "url": "/eia/dokument/318313", "filesize": "2784542", "date": "10.12. 2020"}, {"type": "PDF", "label": "Ferrowim - rozšírenie zariadenia na zber a úpravu - oznámenie zmeny činnosti.pdf", "id": "325059", "url": "/eia/dokument/325059", "filesize": "1746060", "date": "10.12. 2020"}]}, {"title": "Rozhodnutie pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "Rozhodnutie rozšírenie zariadenia na zber a úpravu odpadov  2021.pdf", "id": "325313", "url": "/eia/dokument/325313", "filesize": "426052", "date": "18.05. 2021"}]}, {"title": "Právoplatné rozhodnutie", "items": [{"type": "PDF", "label": "Právoplatné rozhodnutie.pdf", "id": "327653", "url": "/eia/dokument/327653", "filesize": "441479", "date": "29.06. 2021"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"