{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/optimalizacia-vyrobneho-procesu-linky-na-vyrobu-odpadovych-paliv", "@type": "EiaProject", "id": "138624", "seoId": "optimalizacia-vyrobneho-procesu-linky-na-vyrobu-odpadovych-paliv", "name": "Optimalizácia výrobného procesu linky na výrobu odpadových palív", "zbierka": " 24/2006 novela 142/2017 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.6", "label": "Zhodnocovanie ostatných odpadov okrem zhodnocovania odpadov uvedeného v položkách 5 a 11, zariadenia na úpravu a spracovanie ostatných odpadov"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Navrhovaná zmena spočíva vo výmene a rozšírení technologických zariadení vo výrobnej hale SO 202. Nové technologické zariadenia zabezpečia lepšie vytriedenie zložiek nevhodných na úpravu a zároveň budú výkonnejšie a tým vzniká možnosť zvýšenia kapacity spracovania odpadov. Súčasná kapacita prevádzky je maximálne 66 000 t/rok ostatných odpadov, za účelom výroby 55 000 tuhých odpadových palív. Navrhovanou zmenou sa zvýši kapacita vstupu ostatných odpadov na 85 000 t/rok, pričom využiteľnosť bude 75 000 t/rok.  ", "navrhovatel": {"name": "ECOREC Slovensko s.r.o., Glejovka 15, 902 03 Pezinok", "ico": "31358951"}, "prislusnyOrgan": {"name": " Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Pezinok (okres: Pezinok)", "povolujuciOrgan": "IPKZ Bratislava", "schvalujuciOrgan": "IPKZ Bratislava", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zmena navrhovanej činnosti", "number": 1, "items": [{"title": "Text oznámenia o zmene", "items": [{"type": "JPG", "label": "Príloha č.4 situačny plan_ecorec.jpg", "id": "268705", "url": "/eia/dokument/268705", "filesize": "5949176", "date": "21.12. 2017"}, {"type": "PDF", "label": "Oznámenie o zmene navrhovanej činnosti ec