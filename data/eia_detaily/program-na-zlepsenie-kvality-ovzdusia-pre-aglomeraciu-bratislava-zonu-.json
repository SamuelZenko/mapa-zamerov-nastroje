{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/program-na-zlepsenie-kvality-ovzdusia-pre-aglomeraciu-bratislava-zonu-", "@type": "EiaProject", "id": "169413", "seoId": "program-na-zlepsenie-kvality-ovzdusia-pre-aglomeraciu-bratislava-zonu-", "name": "Program na zlepšenie kvality ovzdušia pre aglomeráciu Bratislava a zónu Bratislavský kraj", "zbierka": "24/2006 novela 372/2021 Z.z. časť SEA", "stav": "Verejné prerokovanie", "cinnosti": [{"num": null, "label": "podla § 4, ods. 1"}, {"num": null, "label": "podla § 4, ods. 1"}], "proces": "Povinné hodnotenie", "cezhranicnaSpolupraca": null, "ucel": "PZKO je strategický dokument pre oblasť životného prostredia s regionálnym významom. Je zameraný na ochranu ovzdušia a zlepšenie jeho kvality v Bratislavskom kraji. Tento strategický dokument podlieha povinnému hodnoteniu podľa § 3 písm. b) a d) a § 4 ods. 1 zákona č. 24/2006 Z. z. o posudzovaní vplyvov na životné prostredie a o zmene a doplnení niektorých zákonov v znení neskorších predpisov (ďalej len „zákon“). Jeho cieľom je pomocou navrhovaných opatrení dosiahnuť dobrú kvalitu ovzdušia vo vymedzenom území.", "navrhovatel": {"name": "Ministerstvo vnútra Slovenskej republiky, Okresný úrad Bratislava, odbor starostlivosti o životné prostredie, Tomášikova 46, 832 05 Bratislava  ", "ico": "00151866"}, "prislusnyOrgan": {"name": " Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislavský Kraj ", "povolujuciOrgan": null, "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia o oznámení SD pre verejnosť_ PZKO pre aglomeráciu Bratislava a zónu Bratislavský kraj.pdf", "id": "381877", "url": "/eia/dokument/381877", "filesize": "109365", "date": "19.07. 2024"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "Oznámenie o SD _Program na zlepšenie kvality ovzdušia pre aglomeráciu Bratislava.pdf", "id": "381875", "url": "/eia/dokument/381875", "filesize": "148628", "date": "19.07. 2024"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia", "items": [{"type": "PDF", "label": "ROZSAH HODNOTENIA PZKO pre aglomeráciu Bratislava a zónu  BSK  .pdf", "id": "384146", "url": "/eia/dokument/384146", "filesize": "156247", "date": "25.09. 2024"}, {"type": "PDF", "label": "Doplňujúce informácie č. 1 PZKO BA a BSK.pdf", "id": "385492", "url": "/eia/dokument/385492", "filesize": "455217", "date": "06.11. 2024"}, {"type": "PDF", "label": "Doplňujúce informácie č. 2 PZKO BA a BSK.pdf", "id": "385496", "url": "/eia/dokument/385496", "filesize": "533163", "date": "06.11. 2024"}]}, {"title": "Informácia o rozsahu hodnotenia", "items": [{"type": "PDF", "label": "Informácia o Rozsahu hodnotenia PZKO pre aglomeráciu Bratislava a zónu BSK.pdf", "id": "384147", "url": "/eia/dokument/384147", "filesize": "85545", "date": "25.09. 2024"}]}]}, {"step": "Správa o hodnotení", "number": 3, "items": [{"title": "Informácia o správe o hodnotení", "items": [{"type": "PDF", "label": "INF o zverejneni SoH SD PZKO BA a BSK.pdf", "id": "403649", "url": "/eia/dokument/403649", "filesize": "102928", "date": "03.06. 2026"}]}, {"type": "text", "label": "Spracovateľ správy o hodnotení", "value": ""}, {"title": "Text strategického dokumentu", "items": [{"type": "PDF", "label": "NAVRH STRATEGICKEHO DOKUMENTU PZKO_BA_BSK.pdf", "id": "403650", "url": "/eia/dokument/403650", "filesize": "3368320", "date": "03.06. 2026"}]}, {"title": "Text správy o hodnotení", "items": [{"type": "PDF", "label": "Priloha c. 3 Priklady v minulosti.pdf", "id": "403652", "url": "/eia/dokument/403652", "filesize": "221104", "date": "03.06. 2026"}, {"type": "PDF", "label": "Priloha c. 1 a 2 Vyhodnotenie pripomienok.pdf", "id": "403653", "url": "/eia/dokument/4