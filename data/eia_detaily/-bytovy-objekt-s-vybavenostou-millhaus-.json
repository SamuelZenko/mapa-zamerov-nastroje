{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/-bytovy-objekt-s-vybavenostou-millhaus-", "@type": "EiaProject", "id": "167057", "seoId": "-bytovy-objekt-s-vybavenostou-millhaus-", "name": "„Bytový objekt s vybavenosťou Millhaus“", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.16", "label": "Projekty rozvoja obcí vrátane a) pozemných stavieb alebo ich súborov (komplexov), ak nie sú uvedené v iných položkách tejto prílohy b) statickej dopravy c) územných plánov zóny, ktoré nahrádzajú územné rozhodnutie pre cinnosti uvedené v písmenách a) a b)"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom zámeru „Bytový objekt s vybavenosťou Millhaus“ je výstavba bytového objektu s občianskou vybavenosťou, ktorý sa nachádza v urbanistickej štruktúre ohraničenej z juhu Mlynskými Nivami a zo západu Plynárenskou ulicou. Zo severnej a východnej strany je objekt v podzemnej časti priamo napojený na podzemnú garáž jestvujúceho komplexu BBC V.\r\nFunkčnou náplňou navrhovanej činnosti budú bytové priestory doplnené občianskou vybavenosťou situovanou na 1. NP, rovnako Garni hotel na nadzemných podlažiach (1NP – 8NP). Súčasťou predloženého zámeru je aj výstavba spevnených plôch, sadových úprav a napojenie na inžinierske siete.\r\n", "navrhovatel": {"name": "BBC Residence, s.r.o., Plynárenská 7/C, Bratislava 821 09", "ico": "53076788"}, "prislusnyOrgan": {"name": " Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislava - Ružinov (okres: Bratislava II)", "povolujuciOrgan": "MČ BA RUŽINOV\r\nOÚ BA", "schvalujuciOrgan": "MČ BA RUŽINOV, OÚ BA", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "1. Informácia pre verejnosť Millhaus.pdf", "id": "350207", "url": "/eia/dokument/350207", "filesize": "165577", "date": "24.08. 2022"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "EKOCONSULT"}, {"title": "Text zámeru", "items": [{"type": "ZIP", "label": "Zámer.zip", "id": "350205", "url": "/eia/dokument/350205", "filesize": "26541413", "date": "24.08. 2022"}, {"type": "PDF", "label": "Doplňujúce informácie_Millhaus.pdf", "id": "355760", "url": "/eia/dokument/355760", "filesize": "695521", "date": "07.12. 2022"}]}, {"title": "Rozhodnutie pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "rozhodnutie_bytovy objekt s vybavenostou millhaus.pdf", "id": "360047", "url": "/eia/dokument/360047", "filesize": "3895901", "date": "08.03. 2023"}]}, {"title": "Právoplatné rozhodnutie", "items": [{"type": "PDF", "label": "rozhodnutie_bytovy objekt s vybavenostou millhaus_pravoplatne.pdf", "id": "361717", "url": "/eia/dokument/361717", "filesize": "3870422", "date": "06.04. 2023"}]}]}]}, "blocks": [{"name": "Obsah stránky", "type": "pageContent", "content": null, "params": null, "place": "center"}, {"name": "EIA-SEA", "type": "menu", "content": {"id": 2348, "visibility": true, "items": [{"id": 7719, "parentId": 2348, "name": "Aký je rozdiel medzi EIA a SEA?", "link": "/eia-sea/rozdiel", "children": []}, {"id": 7843, "parentId": 2348, "name": "EIA", "link": "/eia", "children": [{"id": 7721, "parentId": 7843, "name": "Čo je EIA?", "link": "/co-je-eia", "children": []}, {"id": 7722, "parentId": 7843, "name": "Čo predchádza EIA?", "link": "#", "children": [{"id": 7723, "parentId": 7722, "name": "Činnosti predchádzajúce EIA", "link": "/eia/co-jej-predchadza", "children": []}, {"id": 7724, "parentId": 7722, "name": "Zisťovacie konanie", "link": "/eia/zistovacie-konanie", "children": []}, {"id": 7725, "parentId": 7722, "name": "Konanie o podnete", "link": "/eia/konanie-o-podnete", "children": []}, {"id": 7726, "parentId": 7722, "name": "Odborné stanovisko orgánu ochrany prírody a k