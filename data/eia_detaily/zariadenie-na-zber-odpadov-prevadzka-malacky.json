{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/zariadenie-na-zber-odpadov-prevadzka-malacky", "@type": "EiaProject", "id": "168401", "seoId": "zariadenie-na-zber-odpadov-prevadzka-malacky", "name": "Zariadenie na zber odpadov – prevádzka Malacky", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.10", "label": "Zhromažďovanie odpadov zo železných kovov a z neželezných kovov a starých vozidiel, - okrem zhromažďovania odpadov zo zálohovaných jednorazových obalov na nápoje z kovu"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom je zriadenie zariadenia na zber odpadov v zmysle § 5 ods. 1 zákona č. 79/2015 Z. z. o odpadoch a o zmene a doplnení niektorých zákonov v znení neskorších predpisov. Predmetom zberu budú odpady zo železných a neželezných kovov - kategórie ostatný odpad, ktorých pôvodcom je spoločnosť Snop Automotive Malacky, a. s. Tieto kovové odpady budú umiestňované do kontajnerov na to určených. Odpady budú zhromažďované v zmysle vyhlášky č. 371/2015 Z. z., ktorou sa vykonávajú niektoré ustanovenia zákona o odpadoch. Zariadenie bude umiestnené v areály spoločnosti Snop Automotive Malacky, a. s., ktorý je oplotený a uzamykateľný.", "navrhovatel": {"name": "METALIMPEX SLOVAKIA s.r.o., Coburgova 84, 917 02  Trnava", "ico": "35895373"}, "prislusnyOrgan": {"name": " Okresný úrad Malacky", "address": "odbor starostlivosti o životné prostredie,<br /> Záhorácka 2942/60A, 90126 Malacky"}, "dotknutaObec": "Malacky (okres: Malacky)", "povolujuciOrgan": "Okresný úrad Malacky, odbor starostlivosti o životné prostredie, štátna správa odpadového hospodárstva", "schvalujuciOrgan": "Okresný úrad Malacky, odbor starostlivosti o životné prostredie", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Inf