{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/vyroba-asfaltovych-emulzii-pezinok", "@type": "EiaProject", "id": "124062", "seoId": "vyroba-asfaltovych-emulzii-pezinok", "name": "Výroba asfaltových emulzií - Pezinok", "zbierka": "24/2006 novela 314/2014 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.13", "label": "Nadzemné sklady s kapacitou a) zemného plynu a iných plynných médií b) ropy a petrochemických výrobkov c) chemikálií a chemických výrobkov"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovanej činnosti je výroba asfaltových emulzií /nie obaľovacích zmesí na obaľovacej linke/, ktorými sú kationaktívne asfaltové emulzie radu Vialit /modifikované a nemodifikované/, ktoré sa používajú ako spojovacie prostriedky pri údržbe a opravách dopravných komunikácií. Navrhovaná činnosť bude patriť medzi priemyselné činnosti, ale bude mať nevýrobný charakter. Jej účelom nie je zavedenie nového druhu výroby alebo výrobku, ale vybudovanie a prevádzkovanie skladu cestného asfaltu a asfaltových emulzií. ", "navrhovatel": {"name": "DOPRA – VIA  a.s., Drieňova 27, 826 56  Bratislava", "ico": "00684422"}, "prislusnyOrgan": {"name": " Okresný úrad Pezinok", "address": "odbor starostlivosti o životné prostredie,<br /> M. R. Štefánika 10, 90201 Pezinok"}, "dotknutaObec": "Pezinok (okres: Pezinok)", "povolujuciOrgan": "Stavebný úrad , Mesto Pezinok, Radničné nám. 7, 902 14 Pezinok", "schvalujuciOrgan": "Stavebný úrad , Mesto Pezinok, Radničné nám. 7, 902 14 Pezinok", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"type": "text", "label": "Spracovateľ zámeru", "value": "CHEMPIK s.r.o., Klincova 37, 821 08 Bratislava"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "3.emulzie Pezinok 201601 potvrdenie údajov.pdf", "id": "237125", "url": "/eia/dokument/237125", "filesize": "360885", "