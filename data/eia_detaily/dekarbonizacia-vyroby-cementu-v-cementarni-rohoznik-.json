{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/dekarbonizacia-vyroby-cementu-v-cementarni-rohoznik-", "@type": "EiaProject", "id": "169681", "seoId": "dekarbonizacia-vyroby-cementu-v-cementarni-rohoznik-", "name": "Dekarbonizácia výroby cementu v cementárni Rohožník ", "zbierka": "24/2006 novela 372/2021 Z.z. časť EIA", "stav": "Záverečné stanovisko", "cinnosti": [{"num": "6.1", "label": "Cementárne, vápenky (s rotačnými alebo inými pecami) s kapacitou - cementového slinku a/alebo cementu - vápna"}, {"num": "9.5", "label": "Zneškodnovanie alebo zhodnocovanie ostatných odpadov v spalovniach a zariadeniach na spoluspalovanie odpadov"}, {"num": "9.7", "label": "Zneškodnovanie alebo zhodnocovanie nebezpecných odpadov v spalovniach a zariadeniach na spoluspalovanie odpadov, alebo úprava, spracovanie"}, {"num": "9.8", "label": "Zariadenie na zhodnocovanie odpadov tepelnými postupmi"}], "proces": "Povinné hodnotenie", "cezhranicnaSpolupraca": null, "ucel": "Účelom navrhovanej činnosti je realizácia opatrení v prevádzke Danucem Slovensko a.s., Cementáreň Rohožník, ktoré umožnia výrazné zníženie emisii CO2 pri výrobe šedého a bieleho cementu. Zníženie emisií skleníkových plynov pri výrobe cementu bude realizované pomocou technologickej zmeny mletia cementu využitím surovín, ktoré nahradia časť slinku, náhradou tradičných vstupných surovín alternatívnymi surovinami, zlepšením energetickej bilancie výroby a znižovaním využívania fosílnych palív vo výrobe a ich väčšou náhradou za alternatívne palivá. Predmetom navrhovanej činnosti je znižovanie emisií vo výrobnom procese v materiálovo a energeticky náročných prevádzkach cementárne Rohožník, a to konkrétne na výrobnej linke šedého slinku PC2 a výrobnej linke bieleho slinku BC, prostredníctvom nasledujúcich opatrení: inštalácie technológie oddeleného mletia a miešania vstupných materiálov pri výrobe cementu na linke šedého slinku; inštalácie technológií na zvýšenie využívania alternatívnych materiálov namiesto tradičných surovín na linke šedého slinku; inštalácie technológií na využívanie alternatívnych palív ako náhrady fosílnych palív pri výrobe šedého slinku; inštalácie technológie splyňovania tuhých alternatívnych palív na linke bieleho slinku a zosúladenie spôsobu nakladania s odpadmi pri spoluspaľovaní TAP na linke výroby šedého a bieleho slinku a pridanie kódu činnosti R12 a R13 (v zmysle prílohy č. 1 zákona č. 79/2015 Z. z o odpadoch a o zmene doplnení niektorých zákonov) do platného integrovaného povolenia.", "navrhovatel": {"name": "Danucem Slovensko a.s.m 906 38 Rohožník", "ico": "00214973"}, "prislusnyOrgan": {"name": " Ministerstvo životného prostredia SR", "address": "Námestie Ľ. Štúra 1, 81235 Bratislava"}, "dotknutaObec": "Rohožník (okres: Malacky)", "povolujuciOrgan": "Slovenská inšpekcia životného prostredia, Inšpektorát životného prostredia Bratislava, , Jeséniova 17, 831 01 Bratislava ", "schvalujuciOrgan": null, "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "PDF", "label": "Informácia pre verejnosť.pdf", "id": "385138", "url": "/eia/dokument/385138", "filesize": "393009", "date": "25.10. 2024"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "EKOS PLUS s.r.o., Zámocké schody 2/A, 811 01 Bratislava "}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "príloha č. 2", "id": "385137", "url": "/eia/dokument/385137", "filesize": "352549", "date": "25.10. 2024"}, {"type": "PDF", "label": "príloha č. 1", "id": "385136", "url": "/eia/dokument/385136", "filesize": "274424", "date": "25.10. 2024"}, {"type": "PDF", "label": "zámer navrhovanej činnosti ", "id": "385135", "url": "/eia/dokument/385135", "filesize": "8527719", "date": "25.10. 2024"}]}]}, {"step": "Rozsah hodnotenia", "number": 2, "items": [{"title": "Text rozsahu hodnotenia navrhovanej činnosti", "items": [{"type": "PDF", "label": "RH Dekarbonizácia výroby cementu v cementárni Rohožník.pdf", "id": "386984", "url": "/eia/dokument/386984", "filesize": "1035545", "date": "20.12. 2024"}, {"type": "PDF", "label": "Právoplatný RH.pdf", "id": "387826", "url": "/eia/dokument/387826", "filesize": "1154717", "date": "23.01. 2025"}]}]}, {"step": "Správa o hodnotení", "number": 3, "items": [{"title": "Informácia    o správe o hodnotení", "items": [{"type": "PDF", "label": "Informácia pre verejnosť.pdf", "id": "399516", "url": "/eia/dokument/399516", "filesize": "298828", "date": "09.01. 2026"}, {"type": "PDF", "label": "Úkon – zaslanie správy o hodnotení činnosti ", "id": "399639", "url": "/eia/dokument/399639", "filesize": "823942", "date": "15.01. 2026"}]}, {"type": "text", "label": "Spracovateľ správy o hodnotení", "value": ""}, {"title": "Text správy o hodnotení", "items": [{"type": "PDF", "label": "Všeobecne zhrozumiteľné zhrnutie.pdf", "id": "399517", "url": "/eia/dokument/399517", "filesize": "438382", "date": "09.01. 2026"}, {"type": "PDF", "label": "Správa o hodnotení navrhovanej činnosti ", "id": "399514", "url": "/eia/dokument/399514", "filesize": "8749579", "date": "09.01. 2026"}, {"type": "ZIP", "label": "Prílohy.zip", "id": "399515", "url": "/eia/dokument/399515", "filesize": "80922949", "date": "09.01. 2026"}]}]}, {"step": "Verejné prerokovanie", "number": 4, "items": [{"type": "text", "label": "Verejné prerokovanie", "value": "Kultúrny dom Rohožník, Školské námestie 409/3, 906 38 Rohožník 11.02.2026 o 17:00<br />"}]}, {"step": "Záverečné stanovisko", "number": 5, "items": [{"title": "Záverečné stanovisko pred nadobudnutím právoplatnosti", "items": [{"type": "PDF", "label": "ÚKON – upovedomenie účastníkov konania o podkladoch rozhodnutia", "id": "402816", "url": "/eia/dokument/402816", "filesize": "803132", "date": "07.05. 2026"}, {"type": "PDF", "label": "Záverečné stanovisko pred nadobudnutím právoplatnosti ", "id": "404799", "url": "/eia/dokument/404799", "filesize": "1921164", "date": "1