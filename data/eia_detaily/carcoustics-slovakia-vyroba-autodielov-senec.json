{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/carcoustics-slovakia-vyroba-autodielov-senec", "@type": "EiaProject", "id": "21329", "seoId": "carcoustics-slovakia-vyroba-autodielov-senec", "name": "Carcoustics Slovakia -výroba autodielov Senec", "zbierka": "24/2006 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "7.1", "label": "Výroba a montáž motorových vozidiel a výroba motorov motorových vozidiel"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Predmetom posudzovania je prevádzka fy Carcoustics Slovakia umiestneného v juhovýchodnej časti logistickej haly DCIII. Súčasťou prevádzky sú skladové a výrobné priestory, potrebné technické a administratívne zázemie a vnútroareálové komunikácie a parkoviská. Riešená výroba produkuje vnútorné výplne interéru osobných automobilov. Konkrétne sa jedná o podlahové výplne, kryty stredového tunela, podbehy a pod.", "navrhovatel": {"name": "ProLogis Slovak Republik XIV(P)s.r.o., Karadžičova ulica 8/A, 821 08 Bratislava", "ico": "35862378"}, "prislusnyOrgan": {"name": " Okresný úrad ŽP Senec", "address": null}, "dotknutaObec": "Senec (okres: Senec)", "povolujuciOrgan": "Mesto Senec", "schvalujuciOrgan": "Mesto Senec", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "RTF", "label": "Oznámenie o predložení Zámeru", "id": "45221", "url": "/eia/dokument/45221", "filesize": "4185", "date": "20.12. 2007"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "Aquifer s.r.o.,Dúbravská cesta 9,845 20 Bratislava"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "Technologická dispozícia prevádzky Carcoustics", "id": "45029", "url": "/eia/dokument/45029", "filesize": "93328", "date": "18.12. 2007"}, {"type": "PDF", "label": "Textova príloha Klartec", "id": "45036", "url": "/eia/dokument/45036", "filesiz