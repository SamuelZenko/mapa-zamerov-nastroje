{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/zariadenie-na-zber-odpadov-ivanka-pri-dunaji", "@type": "EiaProject", "id": "67157", "seoId": "zariadenie-na-zber-odpadov-ivanka-pri-dunaji", "name": "Zariadenie na zber odpadov Ivanka pri Dunaji", "zbierka": "24/2006 Z.z. časť EIA", "stav": "Akcia je ukončená v procese EIA", "cinnosti": [{"num": "9.7", "label": "Stavby, objekty a zariadenia na nakladanie s nebezpečným odpadom, ak nie sú uvedené v položkách č. 2, 3 a 6"}, {"num": "9.8", "label": "Skladovanie odpadov zo železných kovov a z neželezných kovov a starých vozidiel"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Účelom je vybudovanie zariadenia na zber odpadov v k.ú. Ivanka pri Dunaji. Zariadenie bude slúžiť na zber a dočasné skladovanie prevzatých odpadov. Predmetom budú odpady zo železných a neželezných kovov, odpady z papiera a lepenky, plastové odpady, odpady zo skla, odpady z obalov, odpady z elektrických a elektronických zariadení a opotrebované batérie a akumulátory. Odpady budú odovzdávané na ďalšiu úpravu a zhodnocovanie.", "navrhovatel": {"name": "Zberné suroviny a.s., Kragujevská 3, 010 01 Žilina", "ico": "35701986"}, "prislusnyOrgan": {"name": " Okresný úrad ŽP Senec", "address": null}, "dotknutaObec": "Ivanka pri Dunaji (okres: Senec)", "povolujuciOrgan": "Obec Ivanka pri Dunaji, OUŽP Senec- úsek odpadového hospodárstva", "schvalujuciOrgan": "Obec Ivanka pri Dunaji, OUŽP Senec- úsek odpadovéh", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Zámer", "number": 1, "items": [{"title": "Informácia o zámere", "items": [{"type": "RTF", "label": "Oznámenie o predložení Zámeru /E/", "id": "121289", "url": "/eia/dokument/121289", "filesize": "5498", "date": "12.10. 2011"}]}, {"type": "text", "label": "Spracovateľ zámeru", "value": "Ing. Dominika Kompanová"}, {"title": "Text zámeru", "items": [{"type": "PDF", "label": "Príloha č.4", "id": "121283", "