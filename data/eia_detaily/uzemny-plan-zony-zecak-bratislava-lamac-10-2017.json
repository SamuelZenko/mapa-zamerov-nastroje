{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/uzemny-plan-zony-zecak-bratislava-lamac-10-2017", "@type": "EiaProject", "id": "138042", "seoId": "uzemny-plan-zony-zecak-bratislava-lamac-10-2017", "name": "Územný plán zóny Zečák, Bratislava - Lamač, 10/2017", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "Hlavným cieľom, pre ktorý je Územný plán zóny Zečák, BA - Lamač spracovaný je potreba spodrobniť zásady a regulatívy priestorového usporiadania a fukčného využívania pozemkov a stavieb ako aj verejného dopravného a technického vybavenia, ktoré sú stanovené v Územnom pláne hl. m. SR Bratislavy v znení zmien a doplnkov pre urbanizovaný priestor mesta a získanie komplexnej dokumentácie pre stanovenie optimálneho rozvoja územia, ktorá zabezpečí súlad všetkých zložiek ŽP, priestorové usporiadanie a funkčné využívanie územia, vecnú a časovú koordináciu činností ovplyvňujúcich ŽP a aj ekologickú stabilitu v súlade s princípmi trvalo udržateľného rozvoja a rešpektovaním potenciálnych prejavov klimatickej zmeny.", "navrhovatel": {"name": "Mestská časť Bratislava - Lamač", "ico": "00603414"}, "prislusnyOrgan": {"name": "Okresný úrad Bratislava", "address": "odbor starostlivosti o životné prostredie,<br /> Tomášikova 46, 832 05 Bratislava"}, "dotknutaObec": "Bratislava - Lamač (okres: Bratislava IV)", "povolujuciOrgan": null, "schvalujuciOrgan": "Miestne zastupiteľstvo MČ BA - Lamač", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "informacia SEA - ÚP Z Zecák, BA - Lamac.pdf", "id": "267553", "url": "/eia/dokument/267553", "filesize": "205735", "date": "01.12. 2017"}]}, {"title": "Oznámenie", "items": [{"type": "PDF"