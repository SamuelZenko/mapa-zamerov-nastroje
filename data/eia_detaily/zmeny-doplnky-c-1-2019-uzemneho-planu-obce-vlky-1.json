{"@context": "/api/contexts/EiaProject", "@id": "/api/eia_projects/zmeny-doplnky-c-1-2019-uzemneho-planu-obce-vlky-1", "@type": "EiaProject", "id": "160073", "seoId": "zmeny-doplnky-c-1-2019-uzemneho-planu-obce-vlky-1", "name": "Zmeny a doplnky č. 1/2019 Územného plánu obce Vlky", "zbierka": " 24/2006 novela 142/2017 Z.z. časť SEA", "stav": "Akcia je ukončená v procese SEA", "cinnosti": [{"num": null, "label": "podla § 4, ods. 2"}], "proces": "Zisťovacie konanie", "cezhranicnaSpolupraca": null, "ucel": "\r\nHlavným cieľom obstarania a spracovania dokumentu \"ZaD č. 1/2019 ÚPN-O Vlky\" je zosúladiť navrhované zmeny funkčného využívania územia s komplexným riešením priestorového usporiadania a funkčného využitia územia a premietnuť ich do záväznej časti schváleného územného plánu obce. Dokumentácia Zmeny a doplnky č. 1/2019 Územného plánu obce Vlky bola prerokovávaná v dátume od 23.9.2019 do 23.10.2019, avšak z dôvodov zmenených skutočností bolo potrebné zmeniť rozsah riešenia tohto dokumentu.  Z tohto dôvodu obstarávateľ predložil oznámenie opäť v redukovanej forme. Zmena vo výmere a funkčnom využití nastala v lokalite č. 8.", "navrhovatel": {"name": "Obec Vlky, 900 44 Vlky 83", "ico": "508331"}, "prislusnyOrgan": {"name": "Okresný úrad Senec", "address": "odbor starostlivosti o životné prostredie,<br /> Hurbanova 21, 90301 Senec"}, "dotknutaObec": "Vlky (okres: Senec)", "povolujuciOrgan": null, "schvalujuciOrgan": "Obecné zastupiteľstvo Vlky", "dokumenty": {"available": {"status": false, "message": ""}, "availableOnRequest": false, "data": [{"step": "Oznámenie", "number": 1, "items": [{"title": "Informácia o oznámení", "items": [{"type": "PDF", "label": "Informácia pre verejnost  Vlky.pdf", "id": "311216", "url": "/eia/dokument/311216", "filesize": "205422", "date": "14.07. 2020"}]}, {"title": "Oznámenie", "items": [{"type": "PDF", "label": "OSD ZaD 1 UPN Vlky.pdf", "id": "311189", "url": "/eia/dokument/311189", "filesize": "462091", "date": "14.07. 2020"}, {"type":